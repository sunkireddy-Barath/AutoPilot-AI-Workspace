 *
 * The BN254 curve (also called alt_bn128) is the elliptic curve used by Ethereum's
 * precompiled contracts for pairing-based ZK proofs. Its scalar field prime is
 * strictly less than 2^254, so all valid field elements fit in a U256.
 *
 * @param value - The U256 value to convert (must satisfy 0 <= value < BN254_FIELD_PRIME)
 * @returns The value as a `Bn254FieldElement`
 * @throws {ConversionError} If value >= BN254_FIELD_PRIME
 *
 * @example
 * ```typescript
 * const u256Value = assertU256(12345n);
 * const fieldElement = convertU256ToBn254FieldElement(u256Value);
 *
 * // Values at or above the BN254 prime are rejected:
 * const tooLarge = assertU256(BN254_FIELD_PRIME);
 * convertU256ToBn254FieldElement(tooLarge); // throws ConversionError
 * ```
 *
 * @see {@link convertBn254FieldElementToU256} — the inverse (always safe)
 * @public
 */
declare function convertU256ToBn254FieldElement(value: U256): Bn254FieldElement;
/**
 * Converts a Bn254FieldElement to a U256.
 *
 * @remarks
 * Input type: `Bn254FieldElement` (bigint, range [0, BN254_FIELD_PRIME - 1]).
 * Output type: `U256` (bigint, range [0, 2^256 - 1]).
 *
 * This is a **widening conversion** — all BN254 field elements are valid U256 values,
 * because BN254_FIELD_PRIME < 2^256. This conversion never throws.
 *
 * Use this when you need to pass a field element to a function that operates on
 * generic 256-bit integers, e.g. for byte encoding via {@link encodeU256ToU256LeBytes}.
 *
 * @param value - The Bn254FieldElement to convert
 * @returns The value as `U256`
 *
 * @example
 * ```typescript
 * const fieldElement = assertBn254FieldElement(12345n);
 * const u256Value = convertBn254FieldElementToU256(fieldElement);
 * // u256Value === 12345n as U256
 * ```
 *
 * @see {@link convertU256ToBn254FieldElement} — the inverse (may throw)
 * @public
 */
declare function convertBn254FieldElementToU256(value: Bn254FieldElement): U256;
/**
 * Converts a U256 to a Curve25519FieldElement.
 *
 * @remarks
 * Input type: `U256` (bigint, range [0, 2^256 - 1]).
 * Output type: `Curve25519FieldElement` (bigint, range [0, 2^255 - 20]).
 *
 * This is a **narrowing conversion**. The Curve25519 field prime is 2^255 - 19,
 * which is strictly less than 2^256. Any U256 value >= 2^255 - 19 is rejected.
 *
 * Curve25519 is used in the Rescue cipher encryption and X25519 key exchange.
 * Field elements must be in canonical form (strictly less than the prime).
 *
 * @param value - The U256 value to convert (must satisfy 0 <= value < 2^255 - 19)
 * @returns The value as a `Curve25519FieldElement`
 * @throws {ConversionError} If value >= CURVE25519_FIELD_PRIME (2^255 - 19)
 *
 * @example
 * ```typescript
 * const u256Value = assertU256(12345n);
 * const fieldElement = convertU256ToCurve25519FieldElement(u256Value);
 *
 * // Values >= 2^255 - 19 are rejected:
 * const tooLarge = assertU256(CURVE25519_FIELD_PRIME);
 * convertU256ToCurve25519FieldElement(tooLarge); // throws ConversionError
 * ```
 *
 * @see {@link convertCurve25519FieldElementToU256} — the inverse (always safe)
 * @public
 */
declare function convertU256ToCurve25519FieldElement(value: U256): Curve25519FieldElement;
/**
 * Converts a Curve25519FieldElement to a U256.
 *
 * @remarks
 * Input type: `Curve25519FieldElement` (bigint, range [0, 2^255 - 20]).
 * Output type: `U256` (bigint, range [0, 2^256 - 1]).
 *
 * This is a **widening conversion** — all Curve25519 field elements are valid U256 values,
 * because CURVE25519_FIELD_PRIME (2^255 - 19) < 2^256. This conversion never throws.
 *
 * @param value - The Curve25519FieldElement to convert
 * @returns The value as `U256`
 *
 * @example
 * ```typescript
 * const fieldElement = assertCurve25519FieldElement(12345n);
 * const u256Value = convertCurve25519FieldElementToU256(fieldElement);
 * ```
 *
 * @see {@link convertU256ToCurve25519FieldElement} — the inverse (may throw)
 * @public
 */
declare function convertCurve25519FieldElementToU256(value: Curve25519FieldElement): U256;
/**
 * Converts a Bn254FieldElement to a Curve25519FieldElement.
 *
 * @remarks
 * Input type: `Bn254FieldElement` (bigint, range [0, BN254_FIELD_PRIME - 1]).
 * Output type: `Curve25519FieldElement` (bigint, range [0, 2^255 - 20]).
 *
 * This is a **narrowing cross-field conversion**. Because BN254_FIELD_PRIME is
 * larger than CURVE25519_FIELD_PRIME, some BN254 field elements cannot be
 * represented in the Curve25519 field. Specifically, values in the range

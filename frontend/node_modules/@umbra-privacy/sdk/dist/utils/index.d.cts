/**
 * Arcium Cryptography Utilities
 *
 * This module provides cryptographic utility functions for the Arcium MPC
 * protocol layer of the Umbra SDK. It covers two distinct concerns:
 *
 * - **Nonce generation** for Rescue cipher (`Rc`) encryption. The Rescue
 *   cipher is used by the Arcium network to encrypt confidential token
 *   account balances before they are stored on Solana. Every encryption
 *   operation requires a fresh, unpredictable 128-bit nonce.
 *
 * - **Computation offset generation** for identifying individual MPC
 *   computations queued on the Arcium network. Each MPC job is given a
 *   unique 64-bit offset that is used to derive the computation account PDA
 *   and the associated MPC callback data PDA.
 *
 * ## Randomness Source
 *
 * All values produced by this module are generated using the Web Crypto API's
 * `crypto.getRandomValues()`, which is available in modern browsers and in
 * Node.js v15+. This is the only acceptable source of randomness for
 * cryptographic nonces; non-cryptographic alternatives such as `Math.random()`
 * MUST NOT be used.
 *
 * @packageDocumentation
 * @since 2.0.0
 * @module utils/cryptography/arcium
 */

/**
 * Generates a cryptographically secure random nonce for Rescue cipher
 * encryption.
 *
 * The nonce is a 128-bit (16-byte) value sampled uniformly at random using
 * `crypto.getRandomValues()`. It is validated against the `RcEncryptionNonce`
 * branded type before being returned, ensuring it satisfies any range
 * constraints imposed by the Rescue cipher implementation.
 *
 * @returns A cryptographically secure random {@link RcEncryptionNonce}
 *   representing a 128-bit unsigned integer suitable for immediate use as a
 *   Rescue cipher nonce.
 * @throws `CryptographyAssertionError` if the generated value fails the
 *   `assertRcEncryptionNonce` validation. Under correct library invariants this
 *   should never happen; the throw is a defense-in-depth guard.
 *
 * @remarks
 * ## Threat Model and Nonce Uniqueness
 *
 * The Rescue cipher is a symmetric stream cipher. Like all stream ciphers it
 * provides confidentiality only when a given key is paired with a unique nonce.
 * Reusing the same (key, nonce) pair for two distinct plaintexts allows a
 * passive adversary to recover the XOR of the two plaintexts, completely
 * compromising confidentiality.
 *
 * With 128-bit random nonces the probability of a collision after `n`
 * independent encryptions under the same key is approximately `n² / 2^129`
 * by the birthday bound. For the volumes expected in the Umbra protocol this
 * risk is negligible; however, callers MUST still generate a fresh nonce for
 * every encryption operation.
 *
 * ## Security Requirements
 *
 * - Generate a new nonce for **every** encryption operation, even if the key
 *   and plaintext are the same as a previous call.
 * - Never derive a nonce deterministically from non-secret data (e.g. a
 *   transaction counter visible on-chain) without a proper key-derivation step,
 *   as this may allow an adversary to predict future nonces.
 * - Nonces are **not secret** — they are stored alongside the ciphertext in
 *   the on-chain `EncryptedUserAccount`. Do not treat them as key
 *   material.
 * - For high-volume applications that exceed 2^64 encryptions per key, rotate
 *   the encryption key.
 *
 * ## Randomness Quality
 *
 * This function delegates to {@link generateRandomU128}, which calls
 * `crypto.getRandomValues()`. Do NOT substitute `Math.random()` or any
 * seeded pseudo-random number generator; they do not provide the unpredictability
 * required for cryptographic nonces.
 *
 * @example
 * ```typescript
 * import { generateRandomNonce } from "@umbra-privacy/sdk";
 *
 * // Generate a fresh nonce for each encryption — never reuse
 * const nonce = generateRandomNonce();
 *
 * // Pair the nonce with the ciphertext for storage on-chain
 * const encryptedBalance = rescueEncrypt(plaintextBalance, accountKey, nonce);
 * const record = { ciphertext: encryptedBalance, nonce };
 * ```
 *
 * @see {@link RcEncryptionNonce} for the branded nonce type definition
 * @see {@link generateRandomU128} for the underlying random 128-bit generation
 * @see {@link generateComputationOffset} for the analogous 64-bit MPC offset
 * @public
 */
declare function generateRandomNonce(): RcEncryptionNonce;
/**
 * Generates a cryptographically secure random computation offset for use as
 * an Arcium MPC computation identifier.
 *
 * The offset is a 64-bit unsigned integer sampled uniformly at random using
 * `crypto.getRandomValues()`. It serves as the seed for deriving two on-chain
 * program-derived addresses (PDAs):
 *
 * - The **computation account PDA** at offset `computationOffset`.
 * - The **MPC callback data PDA** at offset `computationOffset + 1n`.
 *
 * Callers must pass the same offset value to both the queue-computation
 * instruction handler and the corresponding callback instruction so that the
 * Arcium network can route the MPC result to the correct account.
 *
 * @returns A cryptographically secure random {@link U64} value representing
 *   the 64-bit computation offset. The value is suitable for immediate use
 *   as the `computationOffset` parameter in Arcium instruction builders.
 *
 * @remarks
 * ## Why 64 Bits?
 *
 * The Arcium on-chain program uses a `u64` field for computation offsets when
 * deriving PDAs. A 64-bit random value gives a collision probability of
 * approximately `n² / 2^65` after `n` independent calls, which is sufficient
 * for the expected throughput of the Umbra protocol.
 *
 * ## Uniqueness Requirement
 *
 * Two concurrent MPC computations MUST NOT share the same offset because their
 * PDAs would collide, causing one instruction to overwrite or fail against the
 * account created by the other. Generating a fresh random offset per operation
 * makes such collisions negligibly unlikely.
 *
 * ## Randomness Quality
 *
 * This function delegates to {@link generateRandomU64}, which uses
 * `crypto.getRandomValues()`. Do NOT substitute predictable or sequential
 * values; they would allow an adversary to front-run PDA derivation.
 *
 * @example
 * ```typescript
 * import { generateComputationOffset } from "@umbra-privacy/sdk";
 *
 * // Generate a unique offset for each MPC computation
 * const computationOffset = generateComputationOffset();
 *
 * // The MPC callback data account uses the next offset
 * const mpcCallbackDataOffset = computationOffset + 1n;
 *
 * // Pass both offsets to the instruction builder
 * const ix = buildConfidentialDepositInstruction({
 *   computationOffset,
 *   mpcCallbackDataOffset,
 *   // ...
 * });
 * ```
 *
 * @see {@link U64} for the branded 64-bit unsigned integer type
 * @see {@link generateRandomU64} for the underlying random 64-bit generation
 * @see {@link generateRandomNonce} for the analogous 128-bit Rescue cipher nonce
 * @public
 */
declare function generateComputationOffset(): U64;
/**
 * Extracts the Arcium cluster offset from a fetched MXE account.
 *
 * The cluster offset is stored in the `cluster` field of the on-chain MXE
 * account as an `Option<u32>`. This function decodes the account data and
 * returns the cluster offset, or throws if the account does not exist or
 * the cluster has not been set.
 *
 * @param mxeAccount - The raw encoded account data from an RPC fetch.
 * @returns The cluster offset as a number (u32).
 *
 * @throws {UmbraError} if the MXE account does not exist on-chain.
 * @throws {UmbraError} if the MXE account's `cluster` field is `None`.
 *
 * @example
 * ```typescript
 * const accountMap = await accountInfoProvider([mxeAccountAddress, ...otherAddresses]);
 * const clusterOffset = extractClusterOffsetFromMxeAccount(accountMap.get(mxeAccountAddress)!);
 * ```
 *
 * @public
 */
declare function extractClusterOffsetFromMxeAccount(mxeAccount: MaybeEncodedAccount): number;

/**
 * Mathematics Utility Functions
 *
 * Provides cryptographically secure random number generators for the SDK's branded
 * unsigned integer types, as well as bigint decomposition utilities used in Merkle
 * tree path derivation and multi-precision arithmetic.
 *
 * ## Random Number Generation
 *
 * All random generation functions use `crypto.getRandomValues()` — the Web Crypto API's
 * cryptographically secure pseudo-random number generator (CSPRNG). This is suitable for
 * generating nonces, salts, per-session identifiers, and other security-sensitive values.
 * The generated bytes are interpreted in **little-endian** order so that the resulting
 * `bigint` can be round-tripped back to a byte array using the standard LE encoders
 * found in `../common/converters/mathematics`.
 *
 * ## Merkle Tree Utilities
 *
 * `bigintToBinaryArrayLSB` converts a leaf index to the sequence of left/right turns
 * required to navigate from the root of an Indexed Merkle Tree to the corresponding
 * leaf. The LSB-first ordering matches the Circom circuit convention used in the Umbra
 * claim proofs.
 *
 * @packageDocumentation
 * @since 2.0.0
 * @module common/math-utils
 */

/**
 * Generates a cryptographically secure random value branded as `U128`.
 *
 * @remarks
 * Allocates a 16-byte `Uint8Array`, fills it using `crypto.getRandomValues()`, then
 * accumulates the bytes into a `bigint` using little-endian interpretation:
 *
 * ```
 * result = bytes[0] | (bytes[1] << 8) | ... | (bytes[15] << 120)
 * ```
 *
 * The result is guaranteed to be in the range `[0, 2^128 - 1]` and is uniformly
 * distributed across that range, making it safe for use as a cryptographic nonce or
 * random seed.
 *
 * The little-endian byte order matches the on-chain account layout and the SDK's
 * `encodeU128ToU128LeBytes` encoder, so generated values can be serialised into PDA
 * seeds without byte swapping.
 *
 * Typical uses in the Umbra protocol:
 * - Generating the `randomGenerationSeed` field of a new `EncryptedUserAccount`
 *   (as a U128 component before full 256-bit assembly).
 * - Creating per-instruction random nonces for off-chain computation scheduling.
 *
 * @returns A `U128`-branded `bigint` sampled uniformly from `[0, 2^128 - 1]`.
 *
 * @example
 * ```typescript
 * import { generateRandomU128 } from "@umbra-privacy/sdk";
 *
 * const nonce = generateRandomU128();
 * // nonce is a U128 — typed and safe to pass to PDA derivation or encryption helpers.
 * console.log(nonce); // e.g. 198234871236498712364987123649871234n
 * ```
 *
 * @see {@link generateRandomU64} for the 64-bit variant.
 * @see {@link generateRandomU256} for the 256-bit variant.
 * @public
 */
declare function generateRandomU128(): U128;
/**
 * Generates a cryptographically secure random value branded as `U64`.
 *
 * @remarks
 * Allocates an 8-byte `Uint8Array`, fills it using `crypto.getRandomValues()`, then
 * accumulates the bytes into a `bigint` using little-endian interpretation:
 *
 * ```
 * result = bytes[0] | (bytes[1] << 8) | ... | (bytes[7] << 56)
 * ```
 *
 * The result is guaranteed to be in the range `[0, 2^64 - 1]` and is uniformly
 * distributed across that range.
 *
 * Typical uses in the Umbra protocol:
 * - Generating unique identifiers for off-chain computation jobs.
 * - Producing random counters for testing or benchmarking.
 *
 * @returns A `U64`-branded `bigint` sampled uniformly from `[0, 2^64 - 1]`.
 *
 * @example
 * ```typescript
 * import { generateRandomU64 } from "@umbra-privacy/sdk";
 *
 * const jobId = generateRandomU64();
 * // jobId is a U64 — typed and safe to use as a computation identifier.
 * console.log(jobId); // e.g. 12345678901234567890n
 * ```
 *
 * @see {@link generateRandomU128} for the 128-bit variant.
 * @see {@link generateRandomU256} for the 256-bit variant.
 * @public
 */
declare function generateRandomU64(): U64;
/**
 * Generates a cryptographically secure random value branded as `U256`.
 *
 * @remarks
 * Allocates a 32-byte `Uint8Array`, fills it using `crypto.getRandomValues()`, then
 * accumulates the bytes into a `bigint` using little-endian interpretation:
 *
 * ```
 * result = bytes[0] | (bytes[1] << 8) | ... | (bytes[31] << 248)
 * ```
 *
 * The result is guaranteed to be in the range `[0, 2^256 - 1]` and is uniformly
 * distributed across that range.
 *
 * Note that a uniformly random 256-bit value is NOT guaranteed to be a valid BN254
 * or Curve25519 field element (since both field primes are less than 2^256). If a
 * random field element is needed, use the field-specific samplers in
 * `../math/bn254/field-element-sampler` or `../math/curve25519/field-arithmetic`.
 *
 * Typical uses in the Umbra protocol:
 * - Generating the `randomGenerationSeed` (`U256LeBytes`) stored in `EncryptedUserAccount`
 *   to provide additional entropy during nonce derivation.
 * - Producing random blinding factors for UTXO commitment construction.
 *
 * @returns A `U256`-branded `bigint` sampled uniformly from `[0, 2^256 - 1]`.
 *
 * @example
 * ```typescript
 * import { generateRandomU256 } from "@umbra-privacy/sdk";
 *
 * const randomSeed = generateRandomU256();
 * // randomSeed is a U256 — typed and safe to use as a random generation seed.
 * console.log(randomSeed); // e.g. a very large 256-bit integer
 * ```
 *
 * @see {@link generateRandomU64} for the 64-bit variant.
 * @see {@link generateRandomU128} for the 128-bit variant.
 * @public
 */
declare function generateRandomU256(): U256;
/**
 * Converts a non-negative `bigint` to its binary representation as an array of bits
 * in LSB-first (least-significant-bit-first) order, zero-padded to `length` elements.
 *
 * @remarks
 * The Umbra Indexed Merkle Tree stores UTXO commitments in a binary tree. To locate a
 * leaf at a given index, the prover must compute the path from the root to that leaf.
 * Each bit of the leaf index selects the left (0) or right (1) child at each tree level.
 *
 * Circom circuits conventionally process bits starting from the least significant bit
 * (i.e. the deepest level of the tree first). `bigintToBinaryArrayLSB` produces exactly
 * this ordering so that the resulting array can be passed directly to the circuit's
 * path selector inputs without reversal.
 *
 * The function extracts bits using repeated bitwise AND with `1n` and right-shifts,
 * which is efficient for arbitrary-precision `bigint` values. If `value` has fewer than
 * `length` bits, the remaining positions are padded with `0`.
 *
 * @param value - A non-negative `bigint` representing the leaf index or any integer
 *   whose binary decomposition is needed. Negative values are not validated and will
 *   produce implementation-defined output from the bitwise operations.
 * @param length - The desired output array length. The function always returns exactly
 *   this many elements. If `value` requires more bits than `length`, the most
 *   significant bits are silently truncated.
 * @returns An array of `length` integers, each either `0` or `1`, representing the
 *   binary digits of `value` from least significant to most significant.
 *
 * @example
 * ```typescript
 * import { bigintToBinaryArrayLSB } from "@umbra-privacy/sdk";
 *
 * // 5 in binary is 0b101.  LSB first with padding to length 4:
 * bigintToBinaryArrayLSB(5n, 4);
 * // => [1, 0, 1, 0]
 * //     ^           bit 0 (LSB, value & 1 = 1)
 * //        ^        bit 1 (value >> 1 & 1 = 0)
 * //           ^     bit 2 (value >> 2 & 1 = 1)
 * //              ^  bit 3 (value >> 3 & 1 = 0, padding)
 *
 * // Zero is all zeros:
 * bigintToBinaryArrayLSB(0n, 8);
 * // => [0, 0, 0, 0, 0, 0, 0, 0]
 *
 * // Powers of two have exactly one set bit:
 * bigintToBinaryArrayLSB(8n, 5);
 * // => [0, 0, 0, 1, 0]
 * //                ^ bit 3 (the only set bit in 0b1000)
 * ```
 *
 * @privateRemarks
 * The Circom `MerkleTreeInclusionProof` component expects `pathIndices` as an array of
 * 0/1 selectors ordered from leaf to root (i.e. LSB first when the leaf index encodes
 * the path). This matches the output of this function directly.
 *
 * @public
 */
declare function bigintToBinaryArrayLSB(value: bigint, length: number): number[];

/**
 * Token Utilities Module
 *
 * This module provides utilities for working with Solana SPL Token and Token-2022
 * programs, with a focus on the Transfer Fee extension used by some Token-2022 tokens.
 *
 * **Token Programs on Solana:**
 *
 * ```
 * ┌─────────────────────────────────────────────────────────────────────────┐
 * │                      Solana Token Programs                              │
 * ├─────────────────────────────────────────────────────────────────────────┤
 * │                                                                         │
 * │  ┌───────────────────────────┐    ┌───────────────────────────┐         │
 * │  │   SPL Token (Legacy)      │    │   Token-2022              │         │
 * │  ├───────────────────────────┤    ├───────────────────────────┤         │
 * │  │ • Standard fungible       │    │ • All SPL Token features  │         │
 * │  │   tokens                  │    │ • Transfer fees           │         │
 * │  │ • USDC, BONK, etc.        │    │ • Interest-bearing        │         │
 * │  │ • No extensions           │    │ • Confidential transfers  │         │
 * │  │                           │    │ • Transfer hooks          │         │
 * │  │                           │    │ • Non-transferable        │         │
 * │  └───────────────────────────┘    └───────────────────────────┘         │
 * │                                                                         │
 * └─────────────────────────────────────────────────────────────────────────┘
 * ```
 *
 * **Transfer Fee Extension:**
 *
 * Token-2022 tokens can have a transfer fee that is automatically deducted
 * on every transfer. This module provides utilities to:
 * - Extract transfer fee configuration from mint account data
 * - Calculate the fee for a given transfer amount
 * - Handle epoch-based fee schedule transitions
 *
 * **Fee Calculation Formula:**
 *
 * ```
 * fee = ceil((amount × basisPoints) / 10000)
 * actualFee = min(fee, maximumFee)
 * ```
 *
 * Where:
 * - `basisPoints`: Fee percentage × 100 (e.g., 1% = 100 bps)
 * - `maximumFee`: Cap on the fee regardless of amount
 *
 * @example
 * Checking if a token has transfer fees:
 * ```typescript
 * import { extractTransferFeeConfig, calculateTransferFee } from "@umbra-privacy/sdk";
 *
 * // Fetch mint account data
 * const mintAccount = await accountInfoProvider([mintAddress]);
 * const feeConfig = extractTransferFeeConfig(mintAccount.get(mintAddress)?.data);
 *
 * if (feeConfig) {
 *     const epochInfo = await getEpochInfo();
 *     const fee = calculateTransferFee(feeConfig, epochInfo.epoch, amount);
 *     console.log(`Transfer fee: ${fee} tokens`);
 * } else {
 *     console.log("No transfer fee on this token");
 * }
 * ```
 *
 * @packageDocumentation
 * @module common/token
 */

/**
 * Transfer fee schedule configuration.
 *
 * Defines the fee parameters that apply during a specific epoch range.
 * Token-2022 mints can have two fee schedules (older and newer) to allow
 * gradual fee changes without disruption.
 *
 * **Schedule Activation:**
 * - The `olderTransferFee` is active when `currentEpoch < newerTransferFee.epoch`
 * - The `newerTransferFee` becomes active when `currentEpoch >= newerTransferFee.epoch`
 *
 * **Basis Points:**
 * Fees are specified in basis points (bps) where 1 bps = 0.01%.
 *
 * | Basis Points | Percentage |
 * |--------------|------------|
 * | 1 | 0.01% |
 * | 10 | 0.1% |
 * | 100 | 1% |
 * | 1000 | 10% |
 * | 10000 | 100% |
 *
 * @see {@link TransferFeeConfig}
 * @see {@link calculateTransferFee}
 * @public
 */
interface TransferFeeSchedule {
    /**
     * Solana epoch at which this fee schedule becomes active.
     *
     * @remarks
     * Solana epochs are approximately 2–3 days. When the cluster reaches this epoch number,
     * this schedule's fee parameters replace the older schedule.
     */
    epoch: bigint;
    /**
     * Maximum fee that can be charged per transfer, in token base units.
     *
     * @remarks
     * Caps the fee regardless of transfer amount. For example, if
     * `maximumFee = 1_000_000` and the token has 6 decimals, the cap is 1 token.
     * A value of `BigInt.MAX_VALUE` effectively removes the cap.
     */
    maximumFee: bigint;
    /**
     * Fee in basis points (hundredths of a percent).
     *
     * @remarks
     * A value of 100 bps equals 1%. Valid range is 0–10000 (0%–100%).
     * The fee formula is: `ceil((amount * transferFeeBasisPoints) / 10000)`, capped at `maximumFee`.
     */
    transferFeeBasisPoints: number;
}
/**
 * Transfer Fee Config extension data.
 *
 * Complete transfer fee configuration for a Token-2022 mint.
 * Contains authorities, withheld amounts, and both fee schedules.
 *
 * **Extension Layout:**
 *
 * ```
 * ┌────────────────────────────────────────┐
 * │ Transfer Fee Config (108 bytes)        │
 * ├────────────────────────────────────────┤
 * │ transferFeeConfigAuthority (36 bytes)  │  COption<Pubkey>
 * │ withdrawWithheldAuthority (36 bytes)   │  COption<Pubkey>
 * │ withheldAmount (8 bytes)               │  u64
 * │ olderTransferFee (18 bytes)            │  TransferFeeSchedule
 * │ newerTransferFee (18 bytes)            │  TransferFeeSchedule
 * └────────────────────────────────────────┘
 * ```
 *
 * **Fee Collection:**
 * When transfers occur, fees are "withheld" in the recipient's token account.
 * The `withdrawWithheldAuthority` can collect these fees using the
 * `WithdrawWithheldTokensFromAccounts` instruction.
 *
 * @see {@link TransferFeeSchedule}
 * @see {@link extractTransferFeeConfig}
 * @see {@link calculateTransferFee}
 * @public
 */
interface TransferFeeConfig {
    /**
     * Authority that can modify the transfer fee configuration.
     *
     * @remarks
     * If `null`, the transfer fee is permanently immutable (no one can change it).
     */
    transferFeeConfigAuthority: Address | null;
    /**
     * Authority that can withdraw fees that have been withheld in token accounts.
     *
     * @remarks
     * If `null`, withheld fees can never be withdrawn and are effectively burned.
     * Use `HarvestWithheldTokensToMint` followed by `WithdrawWithheldTokensFromMint`
     * to collect fees if this authority is set.
     */
    withdrawWithheldAuthority: Address | null;
    /**
     * Total amount of fees currently withheld on the mint account itself (in token base units).
     *
     * @remarks
     * Individual token accounts accumulate fees in their own `withheldAmount` field.
     * Calling `HarvestWithheldTokensToMint` transfers those per-account fees to this
     * mint-level accumulator.
     */
    withheldAmount: bigint;
    /**
     * The older (currently active if epoch has not advanced) transfer fee schedule.
     *
     * @remarks
     * This schedule is active when `currentEpoch < newerTransferFee.epoch`.
     */
    olderTransferFee: TransferFeeSchedule;
    /**
     * The newer (pending or active) transfer fee schedule.
     *
     * @remarks
     * This schedule becomes active when `currentEpoch >= newerTransferFee.epoch`.
     */
    newerTransferFee: TransferFeeSchedule;
}
/**
 * Extracts the Transfer Fee Config extension from mint account data.
 *
 * Parses raw mint account bytes to find and decode the Transfer Fee Config
 * extension if present. This function handles the Token-2022 extension
 * serialization format.
 *
 * **Extension Detection Flow:**
 *
 * ```
 * mintData
 *    │
 *    ▼
 * ┌──────────────────────────────────────┐
 * │ 1. Check minimum length (> 83 bytes) │
 * └──────────────────────────────────────┘
 *    │
 *    ▼
 * ┌──────────────────────────────────────┐
 * │ 2. Verify account type = 1 (Mint)    │
 * └──────────────────────────────────────┘
 *    │
 *    ▼
 * ┌──────────────────────────────────────┐
 * │ 3. Iterate through extensions        │
 * │    • Read type (2 bytes)             │
 * │    • Read length (2 bytes)           │
 * │    • Check if type = 1 (TransferFee) │
 * └──────────────────────────────────────┘
 *    │
 *    ▼
 * ┌──────────────────────────────────────┐
 * │ 4. Parse Transfer Fee Config data    │
 * └──────────────────────────────────────┘
 * ```
 *
 * **Return Conditions:**
 * - Returns `null` if mint data is too short for extensions
 * - Returns `null` if account type is not Mint (1)
 * - Returns `null` if Transfer Fee Config extension not found
 * - Returns `null` if extension data is malformed
 * - Returns `TransferFeeConfig` if successfully parsed
 *
 * @param mintData - Raw bytes of the on-chain mint account (`accountInfo.data`)
 * @returns The parsed `TransferFeeConfig` if the extension is present and valid,
 *   or `null` if not found or the data is malformed
 *
 * @example
 * ```typescript
 * import { extractTransferFeeConfig } from "@umbra-privacy/sdk";
 *
 * const mintAccount = await accountInfoProvider([mintAddress]);
 * const mintData = mintAccount.get(mintAddress)?.data;
 *
 * if (mintData) {
 *     const feeConfig = extractTransferFeeConfig(mintData);
 *     if (feeConfig) {
 *         console.log("Token has transfer fees");
 *         console.log(`Fee: ${feeConfig.olderTransferFee.transferFeeBasisPoints} bps`);
 *     }
 * }
 * ```
 *
 * @see {@link TransferFeeConfig}
 * @see {@link calculateTransferFee}
 * @public
 */
declare function extractTransferFeeConfig(mintData: Uint8Array | undefined): TransferFeeConfig | null;
/**
 * Calculates the transfer fee for a given amount based on the fee configuration.
 *
 * Computes the fee that will be deducted from a transfer based on the
 * active fee schedule. The fee is calculated using basis points and
 * capped at the maximum fee.
 *
 * **Fee Calculation:**
 *
 * ```
 * rawFee = ceil((amount × basisPoints) / 10000)
 * actualFee = min(rawFee, maximumFee)
 * ```
 *
 * **Schedule Selection:**
 * - If `currentEpoch >= newerTransferFee.epoch`: Use `newerTransferFee`
 * - Otherwise: Use `olderTransferFee`
 *
 * **Rounding:**
 * The fee is rounded UP (ceiling) to ensure the protocol always collects
 * at least the calculated fee amount.
 *
 * **Examples:**
 *
 * | Amount | Basis Points | Max Fee | Raw Fee | Actual Fee |
 * |--------|--------------|---------|---------|------------|
 * | 1000 | 100 (1%) | 500 | 10 | 10 |
 * | 100000 | 100 (1%) | 500 | 1000 | 500 (capped) |
 * | 50 | 100 (1%) | 500 | 1 | 1 (ceil) |
 * | 1000 | 0 | 0 | 0 | 0 |
 *
 * @param feeConfig - The transfer fee configuration from the mint
 * @param currentEpoch - The current Solana epoch (determines which schedule is active)
 * @param amount - The transfer amount in token base units (before fee)
 * @returns The fee amount in token base units to be withheld
 *
 * @example
 * ```typescript
 * import { extractTransferFeeConfig, calculateTransferFee } from "@umbra-privacy/sdk";
 *
 * const feeConfig = extractTransferFeeConfig(mintData)!;
 * const epochInfo = await getEpochInfo();
 *
 * const transferAmount = 1_000_000n; // 1 token (6 decimals)
 * const fee = calculateTransferFee(feeConfig, epochInfo.epoch, transferAmount);
 *
 * console.log(`Transfer: ${transferAmount}`);
 * console.log(`Fee: ${fee}`);
 * console.log(`Recipient receives: ${transferAmount - fee}`);
 * ```
 *
 * @see {@link extractTransferFeeConfig}
 * @see {@link calculateNetAmountAfterFee}
 * @public
 */
declare function calculateTransferFee(feeConfig: TransferFeeConfig, currentEpoch: bigint, amount: bigint): bigint;
/**
 * Calculates the net amount received by the recipient after the transfer fee is withheld.
 *
 * @remarks
 * This is a convenience wrapper around `calculateTransferFee`. The relationship is:
 * ```
 * netAmount = grossAmount - calculateTransferFee(feeConfig, currentEpoch, grossAmount)
 * ```
 *
 * Use this when you know the gross send amount and need to display the effective receive
 * amount. For the inverse (computing a gross amount that results in a specific net receive),
 * a different calculation is needed.
 *
 * @param feeConfig - The transfer fee configuration parsed from the mint account
 * @param currentEpoch - The current Solana epoch (used to select the active fee schedule)
 * @param grossAmount - The amount being transferred in token base units (before fee deduction)
 * @returns The net amount the recipient receives, in token base units
 *
 * @example
 * ```typescript
 * const netAmount = calculateNetAmountAfterFee(feeConfig, currentEpoch, 1_000_000n);
 * console.log(`Sending 1,000,000 tokens, recipient gets ${netAmount}`);
 * ```
 *
 * @see {@link calculateTransferFee}
 * @see {@link extractTransferFeeConfig}
 * @public
 */
declare function calculateNetAmountAfterFee(feeConfig: TransferFeeConfig, currentEpoch: bigint, grossAmount: bigint): bigint;

/**
 * Type Helper Utilities
 *
 * Provides a set of thin wrapper functions that validate a raw `bigint` (or `Uint8Array`)
 * value and return it typed as one of the SDK's branded types. Each helper delegates to the
 * corresponding `assert*` function from `../types` and then returns the value — the return
 * type narrowing is what makes these helpers useful at call sites.
 *
 * ## Why helpers instead of direct `assert*` calls?
 *
 * The `assert*` functions throw on invalid input and return `void`. When you need the
 * branded result in an expression context (e.g. as a function argument or in an arrow
 * function), you would otherwise need:
 *
 * ```typescript
 * // Without helpers — verbose and requires a temporary variable:
 * assertU64(rawValue, "amount");
 * const amount = rawValue as unknown as U64; // Unsafe cast
 *
 * // With helpers — single expression, type-safe:
 * const amount = createU64(rawValue, "amount");
 * ```
 *
 * The helpers eliminate the unsafe `as unknown as` pattern while keeping assertion
 * semantics (an invalid value throws rather than silently narrowing).
 *
 * ## Organisation
 *
 * Helpers are grouped into five sections:
 * 1. **Mathematics** — `createU32`, `createU64`, `createU128`, `createU256`
 * 2. **Field elements** — `createBn254FieldElement`, `createCurve25519FieldElement`, `createPoseidonKey`
 * 3. **Rescue Cipher** — `createRcPlaintext`, `createRcCiphertext`, `createRcKey`, `createRcEncryptionNonce`
 * 4. **Limbs** — `createBase85Limb`
 * 5. **Protocol types** — `createOptionalData32`, `createMicroLamportsPerAcu`
 * 6. **Array indexing** — `getByteAt`
 *
 * @packageDocumentation
 * @since 2.0.0
 * @module common/type-helpers
 */

/**
 * Validates a `bigint` as a 32-bit unsigned integer and returns it branded as `U32`.
 *
 * @remarks
 * Delegates to `assertU32` from `../types`. The assertion verifies that `value` is a
 * `bigint` in the closed range `[0, 2^32 - 1]` (i.e. `[0, 4294967295]`). If the value
 * is out of range or is not a `bigint`, a `MathematicsAssertionError` is thrown.
 *
 * `U32` values appear in the Umbra SDK as mixer tree indices, insertion indices, and
 * other slot or offset fields that fit within a 32-bit unsigned range. When feeding
 * user-supplied values (e.g. from a CLI argument or JSON payload) into SDK functions
 * that expect `U32`, always call `createU32(BigInt(value))` rather than passing a
 * raw `number` or relying on implicit coercion.
 *
 * @param value - The raw `bigint` to validate and brand.
 * @returns The same `bigint` value, branded as {@link U32}.
 * @throws `MathematicsAssertionError` if `value` is not a `bigint` or exceeds `2^32 - 1`.
 *
 * @example
 * ```typescript
 * import { createU32 } from "@umbra-privacy/sdk";
 *
 * const treeIndex = createU32(0n);
 * const startIndex = createU32(100n);
 *
 * // Convert from a JS number first (e.g. from user input or Zod-validated schema):
 * const userInputIndex = 42;
 * const safeIndex = createU32(BigInt(userInputIndex));
 *
 * // Throws for out-of-range values:
 * createU32(-1n);            // MathematicsAssertionError
 * createU32(2n ** 32n);      // MathematicsAssertionError
 * ```
 *
 * @see {@link assertU32} for the underlying assertion.
 * @see {@link createU64} for the 64-bit variant.
 * @see {@link createU128} for the 128-bit variant.
 * @public
 */
declare function createU32(value: bigint): U32;
/**
 * Validates a `bigint` as a 64-bit unsigned integer and returns it branded as `U64`.
 *
 * @remarks
 * Delegates to `assertU64` from `../types`. The assertion verifies that `value` is a
 * `bigint` in the closed range `[0, 2^64 - 1]`. If the value is out of range or is
 * not a `bigint`, a `MathematicsAssertionError` is thrown with a message that includes
 * `name` when provided.
 *
 * Prefer this helper over a raw `as U64` cast whenever you do not already hold a
 * branded value — it preserves the runtime safety guarantee that the type implies.
 *
 * @param value - The raw `bigint` to validate and brand.
 * @param name - Optional variable name to include in the error message for easier debugging.
 * @returns The same `bigint` value, branded as {@link U64}.
 * @throws `MathematicsAssertionError` if `value` is not a `bigint` or exceeds `2^64 - 1`.
 *
 * @example
 * ```typescript
 * import { createU64 } from "@umbra-privacy/sdk";
 *
 * const raw = 1_000_000n;
 * const amount: U64 = createU64(raw, "amount");
 *
 * // Throws for negative or oversized values:
 * createU64(-1n);            // MathematicsAssertionError
 * createU64(2n ** 64n);      // MathematicsAssertionError
 * ```
 *
 * @see {@link assertU64} for the underlying assertion.
 * @see {@link createU128} for 128-bit variant.
 * @see {@link createU256} for 256-bit variant.
 * @public
 */
declare function createU64(value: bigint, name?: string): U64;
/**
 * Validates a `bigint` as a 128-bit unsigned integer and returns it branded as `U128`.
 *
 * @remarks
 * Delegates to `assertU128` from `../types`. The assertion verifies that `value` is a
 * `bigint` in the closed range `[0, 2^128 - 1]`. If the value is out of range or is
 * not a `bigint`, a `MathematicsAssertionError` is thrown.
 *
 * In the Umbra protocol, `U128` values appear as instruction seeds (e.g.
 * `CLAIM_INTO_EXISTING_NETWORK_BALANCE_V11_SEED`), generation indices in
 * `EncryptedUserAccount.generationIndex`, and fee offset discriminators.
 *
 * @param value - The raw `bigint` to validate and brand.
 * @param name - Optional variable name to include in the error message for easier debugging.
 * @returns The same `bigint` value, branded as {@link U128}.
 * @throws `MathematicsAssertionError` if `value` is not a `bigint` or exceeds `2^128 - 1`.
 *
 * @example
 * ```typescript
 * import { createU128 } from "@umbra-privacy/sdk";
 *
 * const seed = createU128(340282366920938463463374607431768211455n, "instructionSeed");
 * // seed is now typed as U128 and safe to pass to PDA derivation helpers.
 *
 * // Throws for oversized values:
 * createU128(2n ** 128n); // MathematicsAssertionError
 * ```
 *
 * @see {@link assertU128} for the underlying assertion.
 * @see {@link createU64} for the 64-bit variant.
 * @see {@link createU256} for the 256-bit variant.
 * @public
 */
declare function createU128(value: bigint, name?: string): U128;
/**
 * Validates a `bigint` as a 256-bit unsigned integer and returns it branded as `U256`.
 *
 * @remarks
 * Delegates to `assertU256` from `../types`. The assertion verifies that `value` is a
 * `bigint` in the closed range `[0, 2^256 - 1]`. If the value is out of range or is
 * not a `bigint`, a `MathematicsAssertionError` is thrown.
 *
 * `U256` values are used throughout the SDK for 256-bit cryptographic scalars, such as
 * UTXO commitment preimages, random generation seeds (`randomGenerationSeed`), and
 * Poseidon hash inputs that require full 256-bit precision.
 *
 * @param value - The raw `bigint` to validate and brand.
 * @param name - Optional variable name to include in the error message for easier debugging.
 * @returns The same `bigint` value, branded as {@link U256}.
 * @throws `MathematicsAssertionError` if `value` is not a `bigint` or exceeds `2^256 - 1`.
 *
 * @example
 * ```typescript
 * import { createU256 } from "@umbra-privacy/sdk";
 *
 * const scalar = createU256(commitment, "utxoCommitment");
 * // scalar is now typed as U256 and safe to pass to Poseidon hash functions.
 * ```
 *
 * @see {@link assertU256} for the underlying assertion.
 * @see {@link createU64} for the 64-bit variant.
 * @see {@link createU128} for the 128-bit variant.
 * @public
 */
declare function createU256(value: bigint, name?: string): U256;
/**
 * Validates a `bigint` as a BN254 (alt_bn128) scalar field element and returns it
 * branded as `Bn254FieldElement`.
 *
 * @remarks
 * Delegates to `assertBn254FieldElement` from `../types`. The assertion verifies that
 * `value` is a `bigint` strictly less than the BN254 scalar field prime
 * (21888242871839275222246405745257275088548364400416034343698204186575808495617).
 *
 * `Bn254FieldElement` values are inputs to Groth16 ZK proof verification and Poseidon
 * hash computations performed on the BN254 curve. Passing an out-of-field value would
 * produce incorrect results in the verifier circuit, so this assertion is a critical
 * safety gate.
 *
 * @param value - The raw `bigint` to validate and brand.
 * @param name - Optional variable name to include in the error message for easier debugging.
 * @returns The same `bigint` value, branded as {@link Bn254FieldElement}.
 * @throws `CryptographyAssertionError` if `value` is not a `bigint` or is >= the BN254 field prime.
 *
 * @example
 * ```typescript
 * import { createBn254FieldElement } from "@umbra-privacy/sdk";
 *
 * const publicInput = createBn254FieldElement(leafCommitment, "leafCommitment");
 * // publicInput can now be safely passed to a Poseidon hash or Groth16 verifier.
 *
 * // Throws for values outside the field:
 * createBn254FieldElement(BN254_FIELD_PRIME); // CryptographyAssertionError (not strictly less than)
 * ```
 *
 * @see {@link assertBn254FieldElement} for the underlying assertion.
 * @see {@link createCurve25519FieldElement} for the Curve25519 variant.
 * @see {@link createPoseidonKey} for Poseidon key validation.
 * @public
 */
declare function createBn254FieldElement(value: bigint, name?: string): Bn254FieldElement;
/**
 * Validates a `bigint` as a Curve25519 scalar field element and returns it branded as
 * `Curve25519FieldElement`.
 *
 * @remarks
 * Delegates to `assertCurve25519FieldElement` from `../types`. The assertion verifies
 * that `value` is a `bigint` strictly less than the Curve25519 field prime (2^255 - 19).
 *
 * `Curve25519FieldElement` values are used for X25519 Diffie-Hellman key exchange,
 * which underpins the encrypted balance sharing system in Umbra. The X25519 private and
 * public keys are Curve25519 field elements. Passing an out-of-field scalar to a key
 * exchange function would produce incorrect shared secrets, so this assertion is a
 * safety requirement before any cryptographic operation.
 *
 * @param value - The raw `bigint` to validate and brand.
 * @param name - Optional variable name to include in the error message for easier debugging.
 * @returns The same `bigint` value, branded as {@link Curve25519FieldElement}.
 * @throws `CryptographyAssertionError` if `value` is not a `bigint` or is >= `2^255 - 19`.
 *
 * @example
 * ```typescript
 * import { createCurve25519FieldElement } from "@umbra-privacy/sdk";
 *
 * const privKey = createCurve25519FieldElement(rawKey, "x25519PrivateKey");
 * // privKey is now safely typed for use in X25519 key exchange.
 * ```
 *
 * @see {@link assertCurve25519FieldElement} for the underlying assertion.
 * @see {@link createBn254FieldElement} for the BN254 variant.
 * @public
 */
declare function createCurve25519FieldElement(value: bigint, name?: string): Curve25519FieldElement;
/**
 * Validates a `bigint` as a Poseidon hash key and returns it branded as `PoseidonKey`.
 *
 * @remarks
 * Delegates to `assertPoseidonKey` from `../types`. A `PoseidonKey` is a specialisation
 * of `Bn254FieldElement` used specifically as a key input to the Poseidon encryption
 * scheme. The assertion enforces the same field prime constraint as BN254.
 *
 * In the Umbra protocol, Poseidon keys are derived from the user's master seed and are
 * used to encrypt/decrypt on-chain token account balance ciphertexts. Treating Poseidon
 * keys as a distinct brand (rather than generic `Bn254FieldElement`) prevents them from
 * being accidentally used as public inputs to ZK proofs or vice versa.
 *
 * @param value - The raw `bigint` to validate and brand.
 * @returns The same `bigint` value, branded as {@link PoseidonKey}.
 * @throws `CryptographyAssertionError` if `value` is not a valid BN254 field element.
 *
 * @example
 * ```typescript
 * import { createPoseidonKey } from "@umbra-privacy/sdk";
 *
 * const key = createPoseidonKey(derivedKeyBigint);
 * // key can now be safely passed to the Poseidon encryptor.
 * ```
 *
 * @see {@link assertPoseidonKey} for the underlying assertion.
 * @see {@link createBn254FieldElement} for the parent field element helper.
 * @public
 */
declare function createPoseidonKey(value: bigint): PoseidonKey;
/**
 * Validates a `bigint` as a Rescue Cipher plaintext and returns it branded as `RcPlaintext`.
 *
 * @remarks
 * Delegates to `assertRcPlaintext` from `../types`. The Rescue Cipher is an algebraic
 * cipher used in the Arcium MPC network to encrypt token account balances. A plaintext
 * is a field element (BN254 scalar) representing an unencrypted balance or intermediate
 * value.
 *
 * Branding plaintexts separately from ciphertexts and keys prevents the common
 * mistake of accidentally passing an encrypted value where a plain one is expected,
 * which would silently corrupt balance computations.
 *
 * @param value - The raw `bigint` to validate and brand.
 * @param name - Optional variable name to include in the error message for easier debugging.
 * @returns The same `bigint` value, branded as {@link RcPlaintext}.
 * @throws `CryptographyAssertionError` if `value` is not a valid Rescue Cipher plaintext.
 *
 * @example
 * ```typescript
 * import { createRcPlaintext } from "@umbra-privacy/sdk";
 *
 * const balance = createRcPlaintext(rawBalance, "mxeBalance");
 * // balance is now correctly typed for the Rescue Cipher encrypt call.
 * ```
 *
 * @see {@link assertRcPlaintext} for the underlying assertion.
 * @see {@link createRcCiphertext} for the ciphertext variant.
 * @see {@link createRcKey} for the key variant.
 * @public
 */
declare function createRcPlaintext(value: bigint, name?: string): RcPlaintext;
/**
 * Validates a `bigint` as a Rescue Cipher ciphertext and returns it branded as
 * `RcCiphertext`.
 *
 * @remarks
 * Delegates to `assertRcCiphertext` from `../types`. A Rescue Cipher ciphertext is the
 * encrypted output of the Rescue Cipher applied to an `RcPlaintext`. It is a BN254 field
 * element stored in the on-chain `EncryptedTokenAccount` structure.
 *
 * Keeping ciphertexts distinctly branded from plaintexts ensures that encrypted values
 * cannot be inadvertently passed to functions that expect plaintext, or vice versa.
 *
 * @param value - The raw `bigint` to validate and brand.
 * @param name - Optional variable name to include in the error message for easier debugging.
 * @returns The same `bigint` value, branded as {@link RcCiphertext}.
 * @throws `CryptographyAssertionError` if `value` is not a valid Rescue Cipher ciphertext.
 *
 * @example
 * ```typescript
 * import { createRcCiphertext } from "@umbra-privacy/sdk";
 *
 * const ct = createRcCiphertext(rawCiphertext, "encryptedBalance");
 * // ct is now correctly typed for the Rescue Cipher decrypt call.
 * ```
 *

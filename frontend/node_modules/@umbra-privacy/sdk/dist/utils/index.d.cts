 * @example
 * ```typescript
 * try {
 *   const narrow = convertU128ToU8(createU128(300n));
 * } catch (error) {
 *   if (error instanceof ConversionError) {
 *     console.error(`Cannot convert ${error.sourceType} to ${error.targetType}`);
 *     console.error(`Reason: ${error.reason}`);
 *   }
 * }
 * ```

/**
 * Converts U8LeBytes to U8BeBytes (endianness swap).
 *
 * @public
 * @param value - The 1-byte little-endian representation to convert
 * @returns The identical byte array re-branded as U8BeBytes
 *
 * @remarks
 * Input type: U8LeBytes (Uint8Array of length 1, little-endian).
 * Output type: U8BeBytes (Uint8Array of length 1, big-endian).
 * For a single byte there is no meaningful distinction between LE and BE;
 * this function copies the byte and re-brands the type, acting as a
 * type-safe no-op. The numeric value encoded is unchanged.
 *
 * @example
 * ```typescript
 * const leBytes = encodeU8ToU8LeBytes(assertU8(42n));
 * const beBytes = convertU8LeBytesToU8BeBytes(leBytes); // same content, BE brand
 * ```
 *
 * @see {@link convertU8BeBytesToU8LeBytes} for the inverse conversion
 * @see {@link encodeU8ToU8LeBytes} to produce U8LeBytes from a U8 integer
 * @see {@link decodeU8LeBytesToU8} to decode U8LeBytes back to U8
 */
declare function convertU8LeBytesToU8BeBytes(value: U8LeBytes): U8BeBytes;
/**
 * Converts U8BeBytes to U8LeBytes (endianness swap).
 *
 * @public
 * @param value - The 1-byte big-endian representation to convert
 * @returns The identical byte array re-branded as U8LeBytes
 *
 * @remarks
 * Input type: U8BeBytes (Uint8Array of length 1, big-endian).
 * Output type: U8LeBytes (Uint8Array of length 1, little-endian).
 * For a single byte this is a type-safe no-op; the byte content is copied unchanged.
 *
 * @example
 * ```typescript
 * const beBytes = encodeU8ToU8BeBytes(assertU8(42n));
 * const leBytes = convertU8BeBytesToU8LeBytes(beBytes); // same content, LE brand
 * ```
 *
 * @see {@link convertU8LeBytesToU8BeBytes} for the inverse conversion
 * @see {@link encodeU8ToU8BeBytes} to produce U8BeBytes from a U8 integer
 * @see {@link decodeU8BeBytesToU8} to decode U8BeBytes back to U8
 */
declare function convertU8BeBytesToU8LeBytes(value: U8BeBytes): U8LeBytes;
/**
 * Converts U16LeBytes to U16BeBytes (endianness swap).
 *
 * @public
 * @param value - The 2-byte little-endian representation to convert
 * @returns A new Uint8Array of length 2 with bytes in reversed (big-endian) order
 *
 * @remarks
 * Input type: U16LeBytes (Uint8Array of length 2, little-endian — byte[0] is LSB).
 * Output type: U16BeBytes (Uint8Array of length 2, big-endian — byte[0] is MSB).
 * The reversal is performed by writing `value[LENGTH-1-i]` into `result[i]` for
 * each index. The encoded integer value is preserved.
 *
 * @example
 * ```typescript
 * // Encoding 0x0102 in LE: [0x02, 0x01]
 * const leBytes = encodeU16ToU16LeBytes(assertU16(0x0102n));
 * const beBytes = convertU16LeBytesToU16BeBytes(leBytes); // [0x01, 0x02]
 * ```
 *
 * @see {@link convertU16BeBytesToU16LeBytes} for the inverse conversion
 * @see {@link encodeU16ToU16LeBytes} to encode U16 to LE bytes
 * @see {@link decodeU16BeBytesToU16} to decode the resulting BE bytes back to U16
 */
declare function convertU16LeBytesToU16BeBytes(value: U16LeBytes): U16BeBytes;
/**
 * Converts U16BeBytes to U16LeBytes (endianness swap).
 *
 * @public
 * @param value - The 2-byte big-endian representation to convert
 * @returns A new Uint8Array of length 2 with bytes in reversed (little-endian) order
 *
 * @remarks
 * Input type: U16BeBytes (Uint8Array of length 2, big-endian — byte[0] is MSB).
 * Output type: U16LeBytes (Uint8Array of length 2, little-endian — byte[0] is LSB).
 * The reversal is performed by writing `value[LENGTH-1-i]` into `result[i]`.
 * The encoded integer value is preserved.
 *
 * @example
 * ```typescript
 * // Encoding 0x0102 in BE: [0x01, 0x02]
 * const beBytes = encodeU16ToU16BeBytes(assertU16(0x0102n));
 * const leBytes = convertU16BeBytesToU16LeBytes(beBytes); // [0x02, 0x01]
 * ```
 *
 * @see {@link convertU16LeBytesToU16BeBytes} for the inverse conversion
 * @see {@link encodeU16ToU16BeBytes} to encode U16 to BE bytes
 * @see {@link decodeU16LeBytesToU16} to decode the resulting LE bytes back to U16
 */
declare function convertU16BeBytesToU16LeBytes(value: U16BeBytes): U16LeBytes;
/**
 * Converts U32LeBytes to U32BeBytes (endianness swap).
 *
 * @public
 * @param value - The 4-byte little-endian representation to convert
 * @returns A new Uint8Array of length 4 with bytes in reversed (big-endian) order
 *
 * @remarks
 * Input type: U32LeBytes (Uint8Array of length 4, little-endian — byte[0] is LSB).
 * Output type: U32BeBytes (Uint8Array of length 4, big-endian — byte[0] is MSB).
 * Bytes are reversed by index. The encoded integer value is preserved.
 *
 * @example
 * ```typescript
 * const leBytes = encodeU32ToU32LeBytes(assertU32(0x01020304n));
 * // leBytes = [0x04, 0x03, 0x02, 0x01]
 * const beBytes = convertU32LeBytesToU32BeBytes(leBytes);
 * // beBytes = [0x01, 0x02, 0x03, 0x04]
 * ```
 *
 * @see {@link convertU32BeBytesToU32LeBytes} for the inverse conversion
 */
declare function convertU32LeBytesToU32BeBytes(value: U32LeBytes): U32BeBytes;
/**
 * Converts U32BeBytes to U32LeBytes (endianness swap).
 *
 * @public
 * @param value - The 4-byte big-endian representation to convert
 * @returns A new Uint8Array of length 4 with bytes in reversed (little-endian) order
 *
 * @remarks

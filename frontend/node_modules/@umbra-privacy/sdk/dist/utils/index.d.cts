 * const curve25519 = convertBn254FieldElementToCurve25519FieldElement(bn254);
 *
 * // This would throw because BN254_FIELD_PRIME > CURVE25519_FIELD_PRIME:
 * const large = assertBn254FieldElement(CURVE25519_FIELD_PRIME);

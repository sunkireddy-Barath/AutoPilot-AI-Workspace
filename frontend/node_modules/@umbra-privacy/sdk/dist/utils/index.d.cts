 * ```
 *
 * @see {@link convertCurve25519FieldElementToBn254FieldElement} — the inverse (always safe)
 * @public
 */
declare function convertBn254FieldElementToCurve25519FieldElement(value: Bn254FieldElement): Curve25519FieldElement;
/**

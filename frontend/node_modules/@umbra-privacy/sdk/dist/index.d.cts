 * @example
 * ```typescript
 * // Check total portfolio value (only shared accounts can be decrypted)
 * const mints = [usdcMint, usdtMint, solMint];
 * const balances = await fetchBalances(mints);
 *
 * let totalValue = 0n;
 * for (const [_, result] of balances) {
 *     if (result.state === 'shared') {
 *         totalValue += result.balance;
 *     }
 * }
 * console.log(`Total portfolio: ${totalValue}`);
 * ```
 *
 * @see {@link QueryEncryptedBalanceFunction} — the type of the returned function
 * @see {@link QueryEncryptedBalanceResult} — the discriminated-union result type
 * @see {@link GetQueryEncryptedBalanceFunctionArgs} — factory argument type
 * @see {@link GetQueryEncryptedBalanceFunctionDeps} — injectable dependency type
 * @see {@link getConvertToSharedEncryptionFunction} — converts MXE accounts so balances can be read

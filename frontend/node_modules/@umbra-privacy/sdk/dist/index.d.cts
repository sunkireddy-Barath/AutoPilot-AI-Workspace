 *   a discriminated `stage` field:
 *   - `"validation"`: Invalid inputs (address, amount, optionalData)
 *   - `"mint-fetch"`: Mint account not found or unknown token program
 *   - `"pda-derivation"`: Arcium account PDA derivation failed
 *   - `"instruction-build"`: Codama instruction builder failed or returned null
 *   - `"transaction-build"`: Blockhash fetch or message construction failed
 *   - `"transaction-compile"`: Partial signing / compilation failed
 *   - `"transaction-sign"`: Wallet signer rejected or returned null
 *   - `"transaction-send"`: Network rejected the transaction or forwarder timed out
 *
 * @example
 * Basic usage with defaults:
 * ```typescript
 * import { getEncryptedBalanceToPublicBalanceDirectWithdrawerFunction } from '@umbra-privacy/sdk';
 *
 * const withdraw = getEncryptedBalanceToPublicBalanceDirectWithdrawerFunction({ client });
 *
 * // Withdraw to self with all defaults
 * const signature = await withdraw(
 *   client.signer.address,
 *   usdcMint,
 *   1000n as U64
 * );
 * ```
 *
 * @example
 * Withdraw to another address:
 * ```typescript
 * const signature = await withdraw(
 *   recipientAddress,
 *   usdcMint,
 *   500n as U64,
 *   { priorityFees: 10000n as U64 }
 * );
 * ```
 *
 * @example
 * With all options:
 * ```typescript
 * const signature = await withdraw(
 *   recipientAddress,
 *   usdcMint,
 *   500n as U64,
 *   {
 *     priorityFees: 10000n as U64,
 *     optionalData: myOptionalData
 *   }
 * );
 * ```
 *
 * @example
 * With custom dependencies:
 * ```typescript
 * const withdraw = getEncryptedBalanceToPublicBalanceDirectWithdrawerFunction(
 *   { client },
 *   {
 *     getLatestBlockhash: myCustomBlockhashProvider,
 *     transactionForwarder: myCustomForwarder,
 *   }
 * );
 * ```
 *
 * @see {@link EncryptedBalanceToPublicBalanceDirectWithdrawerFunction} - The type of the returned function
 * @see {@link EncryptedBalanceToPublicBalanceDirectWithdrawerOptions} - Options accepted by the returned function
 * @see {@link findArciumInfrastructurePdas} - PDA derivation for Arcium accounts
 *
 * @public
 */

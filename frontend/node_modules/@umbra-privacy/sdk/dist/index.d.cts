/**
 * User Registration Implementation.
 *
 * @remarks
 * **Commitment levels** — Pass `accountInfoCommitment` (and `epochInfoCommitment`
 * where applicable) in the options to override the default `"confirmed"` commitment
 * for RPC reads. Defaults to `"confirmed"` when not specified.
 *
 * This module provides the factory function for the idempotent three-step
 * Umbra user registration flow:
 *
 * 1. **Account Initialization** — Creates the `EncryptedUserAccount` PDA.
 * 2. **X25519 Key Registration** — Stores the user's encryption public key on-chain.
 * 3. **Anonymous Usage Registration** — Registers the Poseidon user commitment and
 *    encrypts the Master Viewing Key for the Arcium MXE via a Groth16 ZK proof.
 *
 * The returned function is idempotent: it reads on-chain state before each step
 * and skips steps that are already complete.
 *
 * @module implementation/umbra/services/user/register
 * @packageDocumentation
 */

/**
 * Required arguments for creating a user registration function.
 *
 * @remarks
 * The `client` is the only required argument. It provides the signer, RPC
 * infrastructure, key derivation parameters, and network configuration that
 * the registration function needs to operate.
 *
 * @public
 */
interface GetUserRegisrationFunctionArgs {
    /**
     * The Umbra client instance.
     *
     * @remarks
     * Must be a fully constructed `IUmbraClient` obtained from
     * {@link getUmbraClient}. The client supplies the `signer` for
     * transaction signing, the `accountInfoProvider` for reading on-chain state,
     * and the `transactionForwarder` for broadcasting transactions.
     */
    readonly client: IUmbraClient;
}
/**
 * Optional dependency overrides for {@link getUserRegistrationFunction}.
 *
 * @remarks
 * Every field defaults to a value derived from the client's pre-constructed
 * dependencies. Override individual fields to inject mocks for testing, swap
 * in custom cryptographic implementations, or provide a non-default ZK prover.
 *
 * The dependency groups reflect the internal structure of the registration flow:
 * - **Solana/RPC** — account reads and transaction submission
 * - **Key derivation** — deterministic key generators from the master seed
 * - **Rescue cipher** — Rescue encryption key generation and ciphertext creation
 * - **Commitment** — Poseidon hash-based user commitment generation
 * - **Challenge/polynomial** — Fiat-Shamir challenge and polynomial evaluation
 * - **Poseidon** — Aggregated public input hash generation
 * - **BN254 arithmetic** — Field arithmetic for non-zero validations
 * - **ZK prover** — Groth16 proof generation for anonymous mode
 *
 * @public
 */
interface GetUserRegistrationFunctionDeps {
    readonly rpc?: {
        readonly accountInfoProvider?: AccountInfoProviderFunction;
        readonly blockhashProvider?: GetLatestBlockhash;
        readonly transactionForwarder?: TransactionForwarder;
    };
    readonly keys?: {
        readonly userAccountX25519KeypairDeriver?: Curve25519KeypairGeneratorFunction;
        readonly masterViewingKeyEncryptingX25519KeypairDeriver?: Curve25519KeypairGeneratorFunction;
        readonly mintX25519KeypairDeriver?: MintX25519KeypairDeriverFunction;
        readonly masterViewingKeyGenerator?: MasterViewingKeyDeriverFunction;
        readonly masterViewingKeyBlindingFactorGenerator?: MasterViewingKeyBlindingFactorDeriverFunction;
        readonly poseidonPrivateKeyGenerator?: PoseidonPrivateKeyDeriverFunction;
        readonly poseidonBlindingFactorGenerator?: PoseidonBlindingFactorDeriverFunction;
    };
    readonly crypto?: {
        readonly rescueCommitmentBlindingFactorGenerator?: RescueCommitmentBlindingFactorDeriverFunction;
        readonly randomFactorGenerator?: PolynomialCommitmentFactorDeriverFunction;
        readonly getRcKeyGenerator?: (privateKey: X25519PrivateKey) => RcKeyGeneratorFunction;
        readonly getRcEncryptor?: (privateKey: X25519PrivateKey) => RcEncryptorWithNonceFunction;
        readonly rescueCommitmentGenerator?: RescueCommitmentGeneratorFunction;
        readonly userCommitmentGenerator?: UserCommitmentGeneratorFunction;
        readonly fiatShamirChallengeGenerator?: FiatShamirChallengeGeneratorFunction;
        readonly challengePowersFunction?: ChallengePowersFunction;
        readonly polynomialEvaluator?: PolynomialEvaluatorFunction;
        readonly poseidonAggregator?: PoseidonAggregatorHashFunction;
        readonly bn254ModInverter?: ModuloInvFunction;
        readonly computeLimbwiseSumInverse?: (limbs: Base85LimbTuple) => Bn254FieldElement;
    };
    readonly zkProver?: IZkProverForUserRegistration;
}
/**
 * Creates a user registration function bound to the given client and providers.
 *
 * @remarks
 * This factory creates an idempotent registration function that handles the
 * complete three-step Umbra user registration flow. The returned function can
 * be called repeatedly without side effects — it reads on-chain state before
 * each step and skips steps that are already complete.
 *
 * **Registration Steps:**
 *
 * 1. **Account Initialization** (if `EncryptedUserAccount` PDA does not exist)
 *    - Generates a 32-byte random seed for PDA generation
 *    - Calls `initialise_arcium_encrypted_user_account` on-chain
 *    - Creates the PDA that stores the user's registration state and keys
 *
 * 2. **X25519 Key Registration** (if `confidential: true` and bit 3 not set)
 *    - Derives the user account X25519 keypair from the master seed
 *    - Calls `register_token_public_key` on-chain
 *    - Stores the X25519 public key on-chain for ECDH decryption of incoming UTXOs
 *    - Requires 1,200,000 compute units (Ed25519 signature verification)
 *
 * 3. **User Commitment Registration** (if `anonymous: true` and bit 2 not set)
 *    - Derives all required keys (MVK, Poseidon key, blinding factors, etc.)
 *    - Encrypts the MVK and random polynomial factor using the Rescue cipher
 *    - Generates a Fiat-Shamir transcript and computes the ZK public inputs
 *    - Generates a Groth16 ZK proof via the injected `zkProver`
 *    - Calls `register_user_for_anonymous_usage_v11` on-chain
 *    - Requires 1,200,000 compute units (Groth16 verification)
 *
 * **Idempotency:**
 * Status bits are read from the on-chain account before each step. If a step is
 * already complete, the step is skipped silently — no callbacks are invoked
 * and no transaction is submitted.
 *
 * **Prerequisites:**
 * - `anonymous: true` can be used independently of `confidential`
 * - `anonymous: true` requires a `zkProver` in `deps`
 *
 * @param args - Required configuration; the `client` provides all shared state
 * @param deps - Optional dependency overrides for individual components
 * @returns A {@link UserRegistrationFunction} that performs the multi-step
 *   registration flow when called and returns the on-chain transaction signatures
 *
 * @throws {Error} If `anonymous: true` is requested without `confidential: true`
 * @throws {Error} If `anonymous: true` is requested without a `zkProver` in `deps`
 * @throws {Error} If fetching on-chain account info fails (PDA not derivable)
 * @throws {Error} If any on-chain transaction fails to confirm
 *
 * @example
 * ```typescript
 * import { getUserRegistrationFunction } from '@umbra-privacy/sdk';
 *
 * const register = getUserRegistrationFunction({ client });
 *
 * // Register with both confidential and anonymous modes
 * const signatures = await register({ confidential: true, anonymous: true });
 * console.log(`Completed ${signatures.length} registration transactions`);
 * ```
 *
 * @example
 * ```typescript
 * // Registration with UI progress callbacks
 * const register = getUserRegistrationFunction({ client });
 *
 * const signatures = await register({
 *   confidential: true,
 *   anonymous: true,
 *   callbacks: {
 *     userAccountInitialisation: {
 *       pre: (ctx) => {
 *         if (ctx.skipped) setStatus('Account already exists, skipping...');
 *         else setStatus('Creating Umbra account...');
 *       },
 *       post: (ctx) => {
 *         if (!ctx.skipped) setStatus(`Account created: ${ctx.signature}`);
 *       },
 *     },
 *     registerX25519PublicKey: {
 *       pre: (ctx) => {
 *         if (!ctx.skipped) setStatus('Registering encryption key...');
 *       },
 *     },
 *     registerUserForAnonymousUsage: {
 *       pre: (ctx) => {
 *         if (!ctx.skipped) setStatus('Generating ZK proof (this may take a moment)...');
 *       },
 *     },
 *   },
 * });
 * ```
 *
 * @example
 * ```typescript
 * // Confidential mode only (no anonymous / mixer access)
 * const register = getUserRegistrationFunction({ client });
 * const signatures = await register({ confidential: true, anonymous: false });
 * ```
 *
 * @example
 * ```typescript
 * // Full dependency injection for testing
 * const register = getUserRegistrationFunction(
 *   { client: mockClient },
 *   {
 *     rpc: {
 *       accountInfoProvider: mockAccountInfoProvider,
 *       blockhashProvider: async () => ({ blockhash: 'abc', lastValidBlockHeight: 999 }),
 *       transactionForwarder: mockForwarder,
 *     },
 *     zkProver: mockZkProver,
 *   }
 * );
 * ```
 *
 * @see {@link getUmbraClient}
 * @see {@link UserRegistrationFunction}
 * @see {@link UserRegistrationOptions}
 * @public
 */
declare function getUserRegistrationFunction(args: GetUserRegisrationFunctionArgs, deps?: GetUserRegistrationFunctionDeps): UserRegistrationFunction;


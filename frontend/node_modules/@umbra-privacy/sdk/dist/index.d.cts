/**
 * Default Storage Implementations
 *
 * This module provides default implementations for key storage functions.
 * - Master seed: in-memory closure-based storage
 * - Other keys: no-op storage (always derive fresh, never persist)
 *
 * @module common/storage
 * @since 2.0.0
 */

/**
 * Gets default in-memory storage for master seed.
 *
 * @remarks
 * Uses closure-based storage scoped to the function invocation.
 * The seed persists only in memory and is lost when the application closes.
 *
 * @returns Object with loader and storer functions
 */
declare function getDefaultMasterSeedStorage(): {
    readonly load: MasterSeedLoaderFunction;
    readonly store: MasterSeedStorerFunction;
};
/**
 * Gets default master seed generator.
 *
 * @remarks
 * Default generation process:
 * 1. Signs the full `UMBRA_MESSAGE_TO_SIGN` consent message with the user's wallet
 * 2. Hashes the signature with KMAC256 (dkLen=64) to produce 512-bit seed
 *
 * The consent message is protocol-wide and must not be changed without a protocol
 * upgrade, since all derived keys depend on the exact message bytes.
 *
 * @param signer - The signer to use for seed generation
 * @returns Master seed generator function
 */
declare function getDefaultMasterSeedGenerator(signer: IUmbraSigner): MasterSeedGeneratorFunction;
/**
 * Gets default no-op loader for a key type.
 *
 * @remarks
 * Always returns { exists: false }, forcing fresh derivation each time.
 * This is the default behavior - keys are not cached unless user provides
 * custom storage implementation.
 *
 * @template T - The type of key being loaded
 * @returns Loader function that always returns "not found"
 */
declare function getDefaultKeyLoader<T>(): (...args: unknown[]) => Promise<LoadResult<T>>;
/**
 * Gets default no-op storer for a key type.
 *
 * @remarks
 * Returns { success: true } but doesn't actually store anything.
 * This is the default behavior - keys are derived fresh each time.
 *
 * @returns Storer function that accepts any arguments and returns success
 */
declare function getDefaultKeyStorer(): (...args: unknown[]) => Promise<StoreResult>;

/**
 * Umbra Client Implementation.
 *
 * @remarks
 * This module is the top-level entry point for the Umbra SDK. It provides:
 *
 * - {@link getUmbraClient} — factory function that constructs an
 *   {@link IUmbraClient} from a wallet signer, performing the one-time master
 *   seed derivation step.
 * - {@link getUserRegistrationFunction} — factory that creates the idempotent
 *   user registration function, which handles all on-chain registration steps
 *   (account init, X25519 key registration, anonymous usage commitment).
 *
 * **Architecture overview:**
 * `UmbraClient` is a plain configuration object (not a class) that holds all
 * shared state and injected dependencies for a session. Service-specific factory
 * functions (`getUserRegistrationFunction`, `getDepositFunction`, etc.) accept
 * an `IUmbraClient` and return callable functions, following the functional
 * dependency-injection pattern used throughout the SDK.
 *
 * **Initialization flow:**
 * ```
 * wallet signer
 *   └─► getUmbraClient({ signer, network, rpcUrl, ... })
 *         └─► [one-time signing prompt to derive master seed]
 *         └─► IUmbraClient (config object with all dependencies wired up)
 *               ├─► getUserRegistrationFunction({ client })
 *               ├─► getDepositFunction({ client })
 *               ├─► getClaimFunction({ client })
 *               └─► ... other service factories
 * ```
 *
 * **Dependency injection:**
 * Every factory accepts an optional `deps` argument for overriding individual
 * dependencies. This enables testing without a live Solana RPC node and without
 * a real wallet signer.
 *
 * @since 2.0.0
 * @module implementation/umbra/client
 * @packageDocumentation
 */

/**
 * Arguments for creating an Umbra client from a wallet signer.
 *
 * @remarks
 * These arguments configure all infrastructure dependencies for a session.
 * Required fields are `signer`, `network`, `rpcUrl`, and `rpcSubscriptionsUrl`.
 * Everything else has a sensible default.
 *
 * The client is immutable after construction. To use a different signer or
 * network, create a new client.
 *
 * @public
 */
interface GetUmbraClientArgs {
    /**
     * The signer to use for deriving the master seed and signing transactions.
     *
     * @remarks
     * The signer's `signMessage` method is called exactly once during the first
     * invocation of `getMasterSeed()`. The resulting Ed25519 signature is hashed
     * with Keccak-512 to produce the 64-byte master seed, which is then cached
     * in memory for the lifetime of the client. No further signing prompts are
     * issued for key derivation.
     *
     * The signer's `signTransaction` method is called once per on-chain operation
     * to add the user's fee-payer signature.
     *
     * Implementations must satisfy the {@link IUmbraSigner} interface.
     */
    readonly signer: IUmbraSigner;
    /**
     * Network environment to connect to.
     *
     * @remarks
     * Controls which program ID, Arcium cluster addresses, and Address Lookup
     * Tables are used. The network config is resolved via `getNetworkConfig(network)`
     * and throws if the network is not populated.
     *
     * Accepted values: `"mainnet"`, `"devnet"`, `"localnet"`.
     */
    readonly network: Network;
    /**
     * The Solana JSON-RPC HTTP endpoint URL.
     *
     * @remarks
     * Used to construct the default `accountInfoProvider` and `blockhashProvider`
     * if those dependencies are not overridden in `deps`. Accepts any standard
     * Solana RPC URL including cluster.quiknode.pro, api.mainnet-beta.solana.com,
     * or a local validator.
     */
    readonly rpcUrl: string;
    /**
     * The Solana WebSocket RPC endpoint URL for subscription-based confirmations.
     *
     * @remarks
     * Used to construct the default `transactionForwarder` if not overridden in
     * `deps`. The WebSocket connection enables efficient transaction confirmation
     * via `signatureSubscribe` rather than polling.
     *
     * Typically the same host as `rpcUrl` but with `wss://` scheme.
     */
    readonly rpcSubscriptionsUrl: string;
    /**
     * Optional indexer API endpoint for UTXO discovery and Merkle proof fetching.
     *
     * @remarks
     * When provided, the client's `fetchMerkleProof` and `fetchUtxoData` fields
     * are populated with functions that query the indexer read service. If omitted
     * or empty, those fields are absent from the returned client and UTXO scanning
     * operations will need alternative data sources.
     *
     * The indexer is UNTRUSTED — see indexer.ts for the verification requirements.
     */
    readonly indexerApiEndpoint?: string;
    /**
     * Optional custom protocol/algorithm/scheme version specifiers.
     *
     * @remarks
     * Override individual version specifier functions to opt into non-default
     * protocol, algorithm, or encryption scheme versions. This is typically only
     * needed during protocol upgrades or for testing against a specific version.
     *
     * If not provided, the SDK uses the current default versions returned by
     * `getDefaultProtocolVersion`, `getDefaultAlgorithmVersion`, and
     * `getDefaultSchemeVersion`.
     *
     * @defaultValue Uses default version specifiers for all three fields
     */
    readonly versions?: {
        readonly protocol?: ProtocolVersionSpecifierFunction;
        readonly algorithm?: AlgorithmVersionSpecifierFunction;
        readonly scheme?: SchemeVersionSpecifierFunction;
    };
    /**
     * Optional U512 offsets for key derivation.
     *
     * @remarks
     * Each key in the Umbra key hierarchy is derived by hashing `masterSeed ‖ index ‖ offset`.
     * Offsets allow key rotation: incrementing an offset produces an entirely different
     * derived key from the same master seed, without requiring a new wallet signature.
     *
     * In normal usage all offsets are zero. Key rotation (e.g. after a suspected
     * compromise) is performed by incrementing the relevant offset.
     *
     * @defaultValue `0n` for all offsets
     */
    readonly offsets?: {
        readonly masterViewingKey?: U512;
        readonly poseidonPrivateKey?: U512;
        readonly x25519UserAccountPrivateKey?: U512;
        readonly x25519MasterViewingKeyEncryptingPrivateKey?: U512;
        readonly mintX25519PrivateKey?: U512;
        readonly rescueCommitmentBlindingFactor?: U512;
        readonly randomCommitmentFactor?: U512;
    };

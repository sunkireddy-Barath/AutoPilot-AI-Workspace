/**
 * Rescue Cipher — High-Level Key Exchange and Encryption
 *
 * This module is the **primary encryption layer** for Umbra's confidential token
 * accounts. It provides a high-level interface over the low-level Rescue-XLIX
 * block cipher (in `../rescue-cipher`), adding X25519 Diffie-Hellman key exchange,
 * counter-mode encryption/decryption, key generation, and Poseidon-based encryption
 * commitments.
 *
 * ## Role in the Umbra Protocol
 *
 * Umbra's confidential token accounts store encrypted balances. Every deposit,
 * transfer, or withdrawal must update one or more confidential balances in a way
 * that:
 * 1. Keeps the value hidden from on-chain observers.
 * 2. Allows the Arcium MPC network (the MXE) to re-encrypt or decrypt values
 *    inside a secure multi-party computation.
 * 3. Can be committed to in a ZK proof so the on-chain program can verify
 *    correctness without seeing the plaintext.
 *
 * The Rescue cipher satisfies all three requirements because it is an algebraic
 * cipher over a prime field — circuit-friendly, MPC-friendly, and ZK-friendly.
 *
 * ## X25519 Key Exchange Flow
 *
 * ```
 * Sender                              Arcium MXE (MPC network)
 * ──────                              ────────────────────────
 * 1. senderPrivKey, mxePubKey
 * 2. sharedSecret = X25519(senderPrivKey, mxePubKey)
 * 3. cipher = RescueCipher(sharedSecret)
 * 4. nonce = random 128-bit value
 * 5. (ciphertext, nonce) = cipher.encrypt(plaintext, nonce)
 * 6. Submit (ciphertext, nonce, commitment) on-chain
 *                                     7. MXE decrypts inside MPC using
 *                                        its private key + sender's public key
 * ```
 *
 * The Umbra MXE public key (`umbraX25519PublicKey`) is obtained from the network
 * configuration: `getNetworkConfig(network).mxePubkey`.
 *
 * ## No Caching of Key Material
 *
 * This module deliberately does **not** cache cipher instances, shared secrets, or
 * key material. Each factory function call creates fresh cipher instances. This
 * design minimises the window during which sensitive cryptographic material is held
 * in JavaScript heap memory.
 *
 * ## Module Sections
 *
 * - **Types** — `GetRescueCipherFunction`, `GetRescueCipherFromKeyPairFunction`
 * - **Dependency interfaces** — `RescueCipherFromKeyPairDeps`, `RcEncryptorDeps`,
 *   `RcEncryptorWithNonceDeps`, `RcDecryptorDeps`, `RcKeyGeneratorDeps`
 * - **Cipher instance management** — `getRescueCipher`, `getRescueCipherFromKeyPair`
 * - **Encryption** — `getRescueEncryptorFromPrivateKey`, `getRescueEncryptorWithNonceFromPrivateKey`
 * - **Decryption** — `getRescueDecryptorFromPrivateKey`
 * - **Key generation** — `getRescueKeyGeneratorFromPrivateKey`
 * - **Commitment** — `getRescueCommitmentGenerator`
 *
 * @packageDocumentation
 * @module implementation/cryptography/rescue-cipher
 * @public
 */

/**
 * Function type for creating a {@link RescueCipherInstance} from a {@link SharedSecret}.
 *
 * @param sharedSecret - A valid 32-byte X25519 shared secret derived from a
 *   DH exchange. Used as the symmetric key for the Rescue-XLIX cipher.
 * @returns A freshly constructed {@link RescueCipherInstance} ready for encryption
 *   or decryption operations.
 *
 * @remarks
 * Implementations must not cache the resulting cipher instance; a new instance
 * must be returned on each call to avoid retaining key material in memory.
 *
 * @public
 *
 * @example
 * ```typescript
 * const getCipher: GetRescueCipherFunction = getRescueCipher;
 * const cipher = getCipher(sharedSecret);
 * const ciphertexts = cipher.encrypt(plaintexts, nonceBytes);
 * ```
 */
type GetRescueCipherFunction = (sharedSecret: SharedSecret) => RescueCipherInstance;
/**
 * Function type for creating a {@link RescueCipherInstance} from an X25519 key pair.

/**
 * A complete Groth16 zero-knowledge proof, structured as typed component fields.
 *
 * Groth16 (Groth, 2016) is a pairing-based zkSNARK system that produces
 * succinct, constant-size proofs. A proof consists of three elliptic curve
 * points — two from G1 (A and C) and one from G2 (B) — which are checked by
 * a single batched pairing equation:
 *
 * ```
 * e(A, B) = e(alpha, beta) * e(sum, gamma) * e(C, delta)
 * ```
 *
 * where `alpha`, `beta`, `gamma`, `delta` are fixed verification-key points.
 *
 * @remarks
 * ## Proof Structure (256 bytes total)
 *
 * - `a` — G1 point, 64 bytes. The "witness commitment."
 * - `b` — G2 point, 128 bytes. The "randomised statement."
 * - `c` — G1 point, 64 bytes. The "response/linear combination."
 *
 * ## Security Properties
 *
 * - Proof size is **constant** (256 bytes) regardless of circuit complexity.
 * - On-chain verification cost is constant (3 pairings + linear public-input combination).
 * - Requires a **circuit-specific trusted setup** (powers-of-tau ceremony + circuit-specific
 *   phase 2). The verification key stored on-chain encodes this setup.
 * - Under the generic group model and q-PKE assumption, Groth16 is knowledge-sound.
 *
 * ## Use in Umbra
 *
 * Groth16 proofs are used in Umbra's claim and transfer instructions to prove
 * that a UTXO commitment is correctly formed and that the claimant knows the
 * preimage — all without revealing the UTXO value or the private key.
 *
 * @public
 *
 * @example
 * ```typescript
 * const proofA = new Uint8Array(64);
 * const proofB = new Uint8Array(128);
 * const proofC = new Uint8Array(64);
 * assertGroth16ProofA(proofA);
 * assertGroth16ProofB(proofB);
 * assertGroth16ProofC(proofC);
 *
 * const proof: Groth16Proof = { a: proofA, b: proofB, c: proofC };
 * ```
 *
 * @see {@link Groth16ProofA} — type for the A component
 * @see {@link Groth16ProofB} — type for the B component
 * @see {@link Groth16ProofC} — type for the C component
 * @see {@link ZkProofBytes} — serialised form of this proof
 */
interface Groth16Proof {
    /**
     * The A component of the Groth16 proof.
     *
     * A point on the G1 group of BN254, serialised as 64 bytes.
     * Encodes the prover's commitment to the witness.
     *
     * @readonly
     */
    readonly a: Groth16ProofA;
    /**
     * The B component of the Groth16 proof.
     *
     * A point on the G2 group of BN254, serialised as 128 bytes.
     * Encodes the randomised statement derived from the proving key.
     *
     * @readonly
     */
    readonly b: Groth16ProofB;
    /**
     * The C component of the Groth16 proof.
     *
     * A point on the G1 group of BN254, serialised as 64 bytes.
     * Encodes the prover's linear combination of the witness and randomness.
     *
     * @readonly
     */
    readonly c: Groth16ProofC;
}

 * @example
 * ```typescript
 * // Produced by getRescueEncryptorFromPrivateKey:
 * const { ciphertexts, nonce } = await encryptor([balance]);
 * const ct: RcCiphertext = ciphertexts[0];
 * // ct is in [0, 2^255 - 19)
 * ```

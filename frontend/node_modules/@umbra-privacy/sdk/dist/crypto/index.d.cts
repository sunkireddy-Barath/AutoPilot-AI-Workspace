 * Note: the KMAC key and message roles are reversed compared to most other
 * generators in this module. Here, `domain` is the KMAC key and `message`
 * contains `masterSeed || keystream || offset`.
 *
 * ## Usage in Keystream Commitments
 *
 * ```
 * commitment = Poseidon([keystream, blindingFactor])
 * ```
 *
 * @param args - Required: the Umbra client
 * @param deps - Optional: custom KMAC256 and/or BN254 sampler
 * @returns An async function `(keystream: Bn254FieldElement, offset: U256) => Promise<Bn254FieldElement>`
 *
 * @example
 * ```typescript
 * const generator = getPoseidonKeystreamBlindingFactorDeriver({ client });
 * const bf0 = await generator(keystream0, 0n as U256);
 * const bf1 = await generator(keystream1, 1n as U256);
 * ```
 *
 * @see {@link PoseidonKeystreamBlindingFactorDeriverFunction}
 * @public
 */
declare function getPoseidonKeystreamBlindingFactorDeriver(args: PoseidonKeystreamBlindingFactorDeriverArgs, deps?: PoseidonKeystreamBlindingFactorDeriverDeps): PoseidonKeystreamBlindingFactorDeriverFunction;

/**
 * Rescue Cipher Implementation
 *
 * A standalone implementation of the Rescue-XLIX block cipher and Rescue-Prime
 * hash function over the Curve25519 base field (p = 2^255 - 19).
 *
 * This module replaces the `@arcium-hq/client` dependency with a focused
 * implementation that uses the SDK's own `math/curve25519` field arithmetic and
 * `@noble/hashes` for SHAKE256 XOF sampling. The public API is compatible with
 * the `RescueCipher` class from `@arcium-hq/client` so callers need not change.
 *
 * ## What is Rescue-XLIX?
 *
 * Rescue-XLIX (Aly et al., 2019) is a family of algebraic block ciphers and
 * sponge hash functions designed for efficiency inside arithmetic circuits
 * (ZK-SNARKs, STARKs, MPC). Unlike AES, which relies on binary operations,
 * Rescue operates purely in a prime field GF(p), making it cheap to prove
 * statements about encryptions inside a Groth16 or Plonk proof.
 *
 * Each round of the permutation alternates between:
 * - A forward power map (S-box): `x -> x^5 mod p`
 * - An inverse power map:       `x -> x^ALPHA_INVERSE mod p`
 * - A linear MDS matrix multiply for diffusion
 * - Addition of round constants for key separation
 *
 * ## Module Structure
 *
 * This file is organised into labelled sections in top-down dependency order:
 *
 * - Type-safe access helpers — bounds-checked array/matrix element retrieval
 * - SHAKE256 XOF interface — typed wrapper for the extendable output hash
 * - Serialisation — bigint ↔ little-endian byte array conversion
 * - Field operations — FieldArithmetic adapter + singleton cache
 * - Matrix operations — field-arithmetic matrix multiply, add, exponentiate
 * - Constant-time helpers — bit-array arithmetic for side-channel-resistant CTR
 * - SHAKE256 field element sampling — uniform GF(p) sampling from XOF output
 * - MDS matrix construction — Cauchy MDS for cipher (5x5) and hash (12x12)
 * - Round constant generation — SHAKE256-derived constants with affine recurrence
 * - Rescue permutation — core permutation with intermediate state capture
 * - Rescue-Prime hash (sponge) — absorb/squeeze using the permutation
 * - Key derivation — NIST SP 800-56C Rev 2 KDF using Rescue-Prime hash
 * - CTR mode cipher — encrypt/decrypt field element arrays in counter mode
 * - Public API — `getFieldArithmetic`, `getRescuePrimeHashFunction`, `getRescueCipherInstance`
 *
 * ## Factory Pattern
 *
 * Follows the SDK convention of `create*` (internal, uncached) vs `get*`
 * (public or internal cached) functions with optional `*Deps` dependency
 * injection interfaces.
 *
 * @packageDocumentation
 * @module crypto/rescue-cipher
 * @internal
 */

/**
 * Returns the singleton `FieldArithmetic` adapter for the Curve25519 base field.
 *
 * @remarks
 * On the first call, `createFieldArithmeticAdapter()` is invoked and the result
 * is stored in the module-level `cachedFieldArithmetic` variable. Subsequent
 * calls return the cached instance without any allocation.
 *
 * This function is exported so that callers (e.g., the key derivation function
 * injected via `RescueCipherDeps`) can retrieve the same field arithmetic
 * instance that the cipher and hash use internally.
 *
 * @returns The cached `FieldArithmetic` adapter operating over GF(2^255 - 19)
 *
 * @example
 * ```typescript
 * import { getFieldArithmetic } from "./index";
 *
 * const F = getFieldArithmetic();
 * const a = F.create(-1n);      // FIELD_PRIME - 1n
 * const b = F.add(a, F.ONE);    // 0n
 * const c = F.pow(2n, 10n);     // 1024n
 * ```
 *
 * @public
 */
declare function getFieldArithmetic(): FieldArithmetic;
/**
 * Returns a (cached) Rescue-Prime hash function using the sponge construction.
 *
 * @remarks
 * This is the main entry point for Rescue-Prime hashing. When called without
 * arguments (or without a custom `getFieldArithmetic`), it returns and caches a
 * singleton. Custom deps bypass the cache and always create a fresh instance,
 * which is useful for testing with alternative field implementations.
 *
 * ## Caching Behaviour
 *
 * - No deps provided: returns `cachedRescuePrimeHashFunction` (created on first call).
 * - Custom `getFieldArithmetic` provided: always creates a fresh instance (no caching).
 *
 * @param deps - Optional dependency injection; see `RescuePrimeHashDeps`
 * @returns A `RescuePrimeHashFunction` that computes Rescue-Prime hash digests
 *
 * @example
 * ```typescript
 * import { getRescuePrimeHashFunction } from "./index";
 *
 * // Default usage — cached singleton
 * const hash = getRescuePrimeHashFunction();
 * const digest = hash([1n, 2n, 3n]);
 * // digest.length === 5
 *
 * // Custom field for testing
 * const testHash = getRescuePrimeHashFunction({
 *   getFieldArithmetic: () => myTestField,
 * });
 * const testDigest = testHash([0n]);
 * ```
 *
 * @see `createRescuePrimeHashFunction` — the uncached factory this wraps
 * @see `deriveRescueCipherKey` — uses this hash function internally for KDF
 *
 * @public
 */
declare function getRescuePrimeHashFunction(deps?: RescuePrimeHashDeps): RescuePrimeHashFunction;
/**
 * Returns a Rescue-XLIX cipher instance initialised from a shared secret.
 *
 * @remarks
 * This is the primary public entry point of the `rescue-cipher` module. It:
 *
 * 1. Resolves field arithmetic from `deps.getFieldArithmetic` or the default
 *    SDK adapter (`getFieldArithmetic()`).
 * 2. Resolves the KDF from `deps.deriveKey` or the default NIST SP 800-56C
 *    implementation (`deriveRescueCipherKey`).
 * 3. Delegates to `createRescueCipherInstance` with the resolved dependencies.
 *
 * The returned `RescueCipherInstance` is compatible with the `RescueCipher`
 * class from `@arcium-hq/client`, providing the same `encrypt` and `decrypt`
 * method signatures.
 *
 * ## Security
 *
 * Cipher instances are intentionally NOT cached. Each call to this function
 * creates a fresh instance, which limits the lifetime of the derived key
 * material in memory and reduces the risk of key leakage across multiple
 * independent encryption operations.
 *
 * ## Dependency Injection
 *
 * Custom `deps` bypass the module-level caches. This is useful for:
 * - Unit testing with a fixed/known key derivation function
 * - Benchmarking alternative field arithmetic implementations
 * - Future support for hardware-accelerated field operations
 *
 * @param sharedSecret - A `Uint8Array` of exactly `SECRET_BYTES = 32` bytes
 *   representing a shared secret (typically from X25519 ECDH)
 * @param deps - Optional dependencies; see `RescueCipherDeps`
 * @returns A `RescueCipherInstance` with `encrypt()` and `decrypt()` methods
 *
 * @throws `Error` (via `deriveRescueCipherKey`) if `sharedSecret.length !== 32`
 *
 * @example
 * ```typescript
 * import { getRescueCipherInstance } from "@umbra/sdk/crypto/rescue-cipher";
 *
 * // Typical usage — X25519 shared secret from key exchange
 * const sharedSecret = performX25519KeyExchange(myPrivateKey, theirPublicKey);
 * const nonce = crypto.getRandomValues(new Uint8Array(16));
 * const cipher = getRescueCipherInstance(sharedSecret);
 *
 * // Encrypt a vector of field elements (e.g., confidential token amounts)
 * const plaintext: bigint[] = [1_000_000n, 500_000n];
 * const ciphertext = cipher.encrypt(plaintext, nonce);
 * // ciphertext: number[][], each inner array is 32 bytes
 *
 * // Decrypt on the other side
 * const sameSecret = performX25519KeyExchange(theirPrivateKey, myPublicKey);
 * const cipher2 = getRescueCipherInstance(sameSecret);
 * const recovered = cipher2.decrypt(ciphertext, nonce);
 * // recovered deepEquals plaintext
 *
 * // Testing with injected deps
 * const testCipher = getRescueCipherInstance(sharedSecret, {
 *   deriveKey: (_secret) => [1n, 2n, 3n, 4n, 5n],
 * });
 * ```
 *
 * @see `createRescueCipherInstance` — the internal factory this delegates to
 * @see {@link RescueCipherInstance} — the returned interface
 * @see {@link RescueCipherDeps} — the optional dependency injection interface
 * @see {@link SECRET_BYTES} — the required shared secret byte length (32)
 * @see {@link NONCE_BYTES} — the required nonce byte length for encrypt/decrypt (16)
 *
 * @public
 */
declare function getRescueCipherInstance(sharedSecret: Uint8Array, deps?: RescueCipherDeps): RescueCipherInstance;

/**
 * Poseidon Hash Implementation
 *
 * This module provides Poseidon hashing functionality compatible with Circom's Poseidon
 * implementation. Poseidon is a cryptographic hash function specifically designed for
 * zero-knowledge proof systems, providing efficient and circuit-friendly hashing operations.
 *
 * ## Overview
 *
 * Poseidon is an algebraic hash function optimized for use in SNARK and STARK circuits.
 * It operates natively on field elements, making it significantly more efficient than
 * traditional hash functions (like SHA-256) when used inside zero-knowledge proofs.
 *
 * The Poseidon permutation operates over the BN254 (alt_bn128) scalar field with
 * prime `p = 21888242871839275222246405745257275088548364400416034343698204186575808495617`.
 * Each round applies an S-box layer (`x^5 mod p`), an MDS matrix multiplication for
 * diffusion, and addition of round constants for algebraic protection. The permutation
 * alternates between full rounds (S-box applied to every state element) and partial
 * rounds (S-box applied only to the first state element) to achieve both security and
 * performance targets.
 *
 * ## Key Features
 *
 * - **Circom Compatible**: Produces identical outputs to Circom's Poseidon implementation
 * - **1 to 12 Inputs**: Supports state sizes t from 2 to 13 (1 to 12 data inputs)
 * - **BN254 Field Arithmetic**: Uses the BN254 (alt_bn128) scalar field for ZK compatibility
 * - **No Initialization**: All constants are embedded; ready to use immediately
 * - **Type-Safe**: Uses branded `PoseidonHash` and `Bn254FieldElement` types
 * - **Async Interface**: Returns `Promise` for consistency with other cryptographic APIs
 * - **Caching**: Function instances are cached for optimal performance
 *
 * ## Security Considerations
 *
 * - All inputs must be valid BN254 field elements (less than the field prime)
 * - The hash output is deterministic for the same inputs
 * - Input order matters: `hash([a, b])` ≠ `hash([b, a])`
 * - Security level is approximately 128 bits for all supported arities
 *
 * ## Round Structure
 *
 * The Poseidon permutation for state size `t` uses:
 * - 8 full rounds (4 before and 4 after the partial rounds)
 * - A varying number of partial rounds per arity (56–66, see `ROUNDS_PARTIAL`)
 * - S-box exponent: `x^5 mod p` (the smallest power that is a permutation over BN254)
 *
 * ## Exported API
 *
 * - `getPoseidonHasher()` — Circom-compatible Poseidon hash (1–12 inputs)
 * - `getPoseidonPrf()` — Poseidon-based pseudo-random function
 * - `getPoseidonKeystreamGenerator()` — Counter-mode keystream generation
 * - `getPoseidonEncryptor()` / `getPoseidonDecryptor()` — Symmetric encryption/decryption
 * - `getPoseidonAggregator()` — Two-round aggregation for up to 144 inputs
 * - `getUtxoCommitmentHashGenerator()` — UTXO Merkle tree leaf hash (H2)
 * - `getKeystreamCommitmentGenerator()` — Keystream binding commitments
 * - `MAX_POSEIDON_INPUTS`, `MAX_PRF_SEEDS`, `MAX_AGGREGATOR_INPUTS` — Arity constants
 *
 * ## Usage
 *
 * ```typescript
 * import { getPoseidonHasher, getPoseidonPrf } from '@umbra/sdk';
 * import { assertBn254FieldElement } from '@umbra/sdk/types';
 *
 * // Get the hasher function (cached singleton)
 * const hasher = getPoseidonHasher();
 *
 * // Hash a single value
 * const input1 = 123n;
 * assertBn254FieldElement(input1);
 * const hash1 = await hasher([input1]);
 *
 * // Hash multiple values (up to 12)
 * const inputs = [1n, 2n, 3n];
 * inputs.forEach(assertBn254FieldElement);
 * const hash2 = await hasher(inputs);
 *
 * // Use PRF for key derivation
 * const prf = getPoseidonPrf();
 * const derivedKey = await prf([secretSeed], evaluationPoint);
 * ```
 *
 * @packageDocumentation
 * @module implementation/cryptography/poseidon
 */

/**
 * Maximum number of inputs supported by the Poseidon hash function.
 *
 * This limit is determined by the Circom Poseidon specification, which defines
 * constants for state sizes t=2 to t=13 (corresponding to 1 to 12 inputs).
 *
 * @remarks
 * The Poseidon permutation uses a state of size `t = inputs.length + 1` where the
 * extra element serves as the capacity element (initialized to 0). With t ranging
 * from 2 to 13, the maximum number of data inputs is 12.
 *
 * For hashing more than 12 elements, use the aggregator which chains two rounds
 * of Poseidon and supports up to {@link MAX_AGGREGATOR_INPUTS} (144) total elements.
 *
 * @example
 * ```typescript
 * import { getPoseidonHasher, MAX_POSEIDON_INPUTS } from '@umbra/sdk';
 *
 * const hasher = getPoseidonHasher();
 *
 * // Hash exactly at the limit
 * const inputs = Array.from({ length: MAX_POSEIDON_INPUTS }, (_, i) => BigInt(i));
 * inputs.forEach(assertBn254FieldElement);
 * const hash = await hasher(inputs);
 * ```
 *
 * @see {@link getPoseidonHasher} for the direct hash function (1–12 inputs)
 * @see {@link getPoseidonAggregator} for hashing more than 12 inputs
 * @see {@link MAX_AGGREGATOR_INPUTS} for the aggregator's limit (144 inputs)
 * @public
 */
declare const MAX_POSEIDON_INPUTS = 12;
/**
 * Maximum number of seeds supported by the Poseidon PRF.
 *
 * Since the PRF combines seeds with an evaluation point as the last input,
 * and Poseidon supports at most 12 total inputs, the maximum number of
 * seeds is 11.
 *
 * @remarks
 * The PRF computes `Poseidon(seed_0, ..., seed_n, evaluationPoint)` where the
 * evaluation point occupies the last slot. With {@link MAX_POSEIDON_INPUTS} = 12,
 * at most 11 seeds can be used (11 seeds + 1 evaluation point = 12 total inputs).
 *
 * @example
 * ```typescript
 * import { getPoseidonPrf, MAX_PRF_SEEDS } from '@umbra/sdk';
 *
 * const prf = getPoseidonPrf();
 *
 * // Use up to MAX_PRF_SEEDS seeds
 * const seeds = Array.from({ length: MAX_PRF_SEEDS }, (_, i) => BigInt(i + 1));
 * seeds.forEach(assertBn254FieldElement);
 * const output = await prf(seeds, 0n as Bn254FieldElement);
 * ```
 *
 * @see {@link getPoseidonPrf} for the PRF function factory
 * @see {@link MAX_POSEIDON_INPUTS} for the underlying hash input limit
 * @public
 */
declare const MAX_PRF_SEEDS = 11;
/**
 * Returns a cached Poseidon hash function.
 *
 * This function returns a `PoseidonHashFunction` that computes Poseidon hashes
 * compatible with Circom's implementation. The function instance is cached,
 * so repeated calls return the same function.
 *
 * @returns A `PoseidonHashFunction` that hashes arrays of BN254 field elements
 *
 * @remarks
 * ## Caching
 *
 * The returned function is a cached singleton. Calling `getPoseidonHasher()`
 * multiple times returns the exact same function instance.
 *
 * ## Hash Computation
 *
 * The returned hasher:
 * - Accepts 1 to 12 BN254 field elements
 * - Uses an initial state of `0n` followed by the inputs
 * - Returns a single `Bn254FieldElement` hash output
 * - Produces outputs identical to Circom's Poseidon implementation
 *
 * ## Input Validation
 *
 * Each input element is validated using `assertBn254FieldElement` to ensure:
 * - The value is a `bigint`
 * - The value is non-negative
 * - The value is less than the BN254 field prime
 *
 * @example
 * ```typescript
 * import { getPoseidonHasher } from '@umbra/sdk';
 * import { assertBn254FieldElement } from '@umbra/sdk/types';
 *
 * // Get the hasher (cached singleton)
 * const hasher = getPoseidonHasher();
 *
 * // Hash a single value
 * const input = 123n;
 * assertBn254FieldElement(input);
 * const hash1 = await hasher([input]);
 *
 * // Hash multiple values
 * const inputs: Bn254FieldElement[] = [1n, 2n, 3n];
 * inputs.forEach(assertBn254FieldElement);
 * const hash2 = await hasher(inputs);
 *
 * // Use in Merkle tree construction
 * const left = 100n;
 * const right = 200n;
 * assertBn254FieldElement(left);
 * assertBn254FieldElement(right);
 * const merkleNode = await hasher([left, right]);
 * ```
 *
 * @public
 */
declare function getPoseidonHasher(): PoseidonHashFunction;
/**
 * Optional dependencies for the Poseidon PRF factory.
 *
 * @remarks
 * This interface enables dependency injection for the Poseidon PRF. By providing
 * a custom hasher, callers can substitute test doubles or alternative hash
 * implementations without changing the PRF logic itself.
 *
 * When no dependencies are supplied, `getPoseidonPrf()` uses the cached default
 * hasher returned by `getPoseidonHasher()`.
 *
 * @example
 * ```typescript
 * import { getPoseidonPrf } from '@umbra/sdk';
 *
 * // Use a mock hasher in tests
 * const mockHasher: PoseidonHashFunction = async (inputs) => 42n as Bn254FieldElement;
 * const prf = getPoseidonPrf({ hasher: mockHasher });
 * ```
 *
 * @see {@link getPoseidonPrf}
 * @public
 */
interface PoseidonPrfDeps {
    /**
     * Optional custom hasher function.
     *
     * @remarks
     * When provided, the PRF uses this hasher instead of the default
     * `getPoseidonHasher()` singleton. The result is cached per hasher
     * reference using a `WeakMap`.
     *
     * If not provided, the PRF is cached as a module-level singleton.
     *
     * @defaultValue The return value of `getPoseidonHasher()`
     */
    readonly hasher?: PoseidonHashFunction;
}
/**
 * Returns a cached Poseidon PRF (Pseudo-Random Function).
 *
 * This function returns a `PoseidonPrfFunction` that computes pseudo-random outputs
 * from secret seeds and an evaluation point. The PRF is built on top of the
 * Poseidon hash function.
 *
 * @param deps - Optional dependencies including custom hasher function.
 * @returns A `PoseidonPrfFunction` that computes PRF outputs
 *
 * @remarks
 * ## Caching
 *
 * - When called without arguments (using default hasher), returns a cached singleton
 * - When called with a custom hasher, returns a cached function per hasher instance
 * - The cache uses WeakMap for custom hashers to allow garbage collection
 *
 * ## PRF Computation
 *
 * The PRF combines seeds with the evaluation point:
 * ```
 * PRF(seeds, x) = Poseidon(seed_0, seed_1, ..., seed_n, x)
 * ```
 *
 * ## Input Constraints
 *
 * - Seeds: 1 to 11 elements (to leave room for the evaluation point)
 * - Total inputs (seeds.length + 1) must not exceed 12
 *
 * ## Security Properties
 *
 * - **Deterministic**: Same (seeds, evaluationPoint) always produces the same output
 * - **Pseudo-random**: Output is computationally indistinguishable from random if seeds are secret
 * - **Key-dependent**: Different seeds produce completely different outputs
 *
 * ## Use Cases
 *
 * - Key derivation from master secrets
 * - Nullifier generation in ZK protocols
 * - Commitment schemes
 * - Verifiable random functions
 *
 * @example
 * ```typescript
 * import { getPoseidonPrf } from '@umbra/sdk';
 * import { assertBn254FieldElement } from '@umbra/sdk/types';
 *
 * // Get the PRF (cached singleton)
 * const prf = getPoseidonPrf();
 *
 * // Use with a single seed
 * const seed = secretKey;
 * assertBn254FieldElement(seed);
 * const output = await prf([seed], evaluationPoint);
 *
 * // Use with multiple seeds (up to 11)
 * const seeds: Bn254FieldElement[] = [seed1, seed2, seed3];
 * seeds.forEach(assertBn254FieldElement);
 * const output2 = await prf(seeds, evaluationPoint);
 * ```
 *
 * @example
 * ```typescript
 * // Nullifier generation
 * const prf = getPoseidonPrf();
 *
 * const secretKey: Bn254FieldElement = userPrivateKey;
 * const commitment: Bn254FieldElement = noteCommitment;
 *
 * // Generate nullifier: PRF(sk, commitment)
 * const nullifier = await prf([secretKey], commitment);
 * ```
 *
 * @example
 * ```typescript
 * // Using a custom hasher
 * const customHasher: PoseidonHashFunction = myCustomHasher;
 * const prf = getPoseidonPrf(customHasher);
 *
 * const output = await prf([seed], evaluationPoint);
 * ```
 *
 * @public
 */
declare function getPoseidonPrf(deps?: PoseidonPrfDeps): PoseidonPrfFunction;
/**
 * Optional dependencies for the Poseidon keystream generator factory.
 *
 * @remarks
 * This interface enables dependency injection for the keystream generator.
 * By providing a custom PRF, callers can inject test doubles or alternative
 * PRF implementations without changing the keystream generation logic.
 *
 * When no dependencies are provided, `getPoseidonKeystreamGenerator()` uses
 * the cached default PRF returned by `getPoseidonPrf()`.
 *
 * @example
 * ```typescript
 * import { getPoseidonKeystreamGenerator } from '@umbra/sdk';
 *
 * // Use a mock PRF in tests
 * const mockPrf: PoseidonPrfFunction = async (seeds, point) => 1n as Bn254FieldElement;
 * const gen = getPoseidonKeystreamGenerator({ prf: mockPrf });
 * ```
 *
 * @see {@link getPoseidonKeystreamGenerator}
 * @public
 */
interface PoseidonKeystreamGeneratorDeps {
    /**
     * Optional custom PRF function.
     *
     * @remarks
     * When provided, the keystream generator uses this PRF instead of the default
     * `getPoseidonPrf()` singleton. The result is cached per PRF reference using
     * a `WeakMap`.
     *
     * If not provided, the generator is cached as a module-level singleton.
     *
     * @defaultValue The return value of `getPoseidonPrf()`
     */
    readonly prf?: PoseidonPrfFunction;
}
/**
 * Returns a cached Poseidon keystream generator function.
 *
 * This function returns a `PoseidonKeystreamGeneratorFunction` that generates keystream
 * values for counter-mode encryption operations. The keystream is computed using
 * the Poseidon PRF with a domain-separated evaluation point.
 *
 * @param deps - Optional dependencies including custom PRF function.
 * @returns A `PoseidonKeystreamGeneratorFunction` that generates keystreams for counters
 *
 * @remarks
 * ## Caching
 *
 * - When called without arguments (using default PRF), returns a cached singleton
 * - When called with a custom PRF, returns a cached function per PRF instance
 * - The cache uses WeakMap for custom PRFs to allow garbage collection
 *
 * ## Keystream Generation Formula
 *
 * For each counter, the keystream is computed as:
 * ```
 * keystream = Poseidon([transactionViewingKey, counter, evaluationPoint])
 * ```
 *
 * Where:
 * - `transactionViewingKey` is the master key
 * - `counter` is the position/index for this keystream
 * - `evaluationPoint` is 2 (domain separation constant)
 *
 * ## Security Properties
 *
 * - **Deterministic**: Same (key, counter) pair always produces the same keystream
 * - **Domain-separated**: The evaluation point (2) ensures this PRF is distinct
 *   from other uses of the same key
 * - **Counter-dependent**: Different counters produce completely different keystreams
 *
 * ## Use Cases
 *
 * - Stream cipher encryption in ZK protocols
 * - Generating unique encryption masks for each position
 * - Confidential transaction data encryption
 *
 * @example
 * ```typescript
 * import { getPoseidonKeystreamGenerator } from '@umbra/sdk';
 * import { assertPoseidonKey, assertPoseidonCounter } from '@umbra/sdk/types';
 *
 * // Get the keystream generator (cached singleton)
 * const keystreamGenerator = getPoseidonKeystreamGenerator();
 *
 * // Generate keystreams for positions 0, 1, 2
 * const key: PoseidonKey = transactionViewingKey;
 * assertPoseidonKey(key);
 *
 * const counters: PoseidonCounter[] = [0n, 1n, 2n];
 * counters.forEach(assertPoseidonCounter);
 *
 * const keystreamMap = await keystreamGenerator(counters, key);
 *
 * // Use keystreams for encryption
 * const keystream0 = keystreamMap.get(0n)!;
 * const ciphertext0 = (plaintext0 + keystream0) % BN254_FIELD_PRIME;
 * ```
 *
 * @example
 * ```typescript
 * // Using a custom PRF
 * const customPrf: PoseidonPrfFunction = myCustomPrf;
 * const keystreamGenerator = getPoseidonKeystreamGenerator(customPrf);
 *
 * const keystreamMap = await keystreamGenerator([0n, 1n], key);
 * ```
 *
 * @public
 */
declare function getPoseidonKeystreamGenerator(deps?: PoseidonKeystreamGeneratorDeps): PoseidonKeystreamGeneratorFunction;
/**
 * Optional dependencies for the Poseidon encryptor factory.
 *
 * @remarks
 * This interface enables dependency injection for the Poseidon encryptor. By
 * providing custom implementations of the keystream generator and modular addition
 * function, callers can test the encryptor in isolation or substitute alternative
 * field arithmetic implementations.
 *
 * The encryption formula is:
 * ```
 * ciphertext[i] = modAdd(plaintext[i], keystream[i])
 * ```
 *
 * Where `keystream[i] = Poseidon([key, i, 2])`.
 *
 * @example
 * ```typescript
 * import { getPoseidonEncryptor } from '@umbra/sdk';
 *
 * // Use a mock keystream generator in tests
 * const mockGen: PoseidonKeystreamGeneratorFunction = async (counters, key) => {
 *   const map = new Map();
 *   for (const c of counters) map.set(c, 1n as PoseidonKeystream);
 *   return map;
 * };
 * const encryptor = getPoseidonEncryptor({ keystreamGenerator: mockGen });
 * ```
 *
 * @see {@link getPoseidonEncryptor}
 * @public
 */
interface PoseidonEncryptorDeps {
    /**
     * Custom keystream generator function.
     *
     * @remarks
     * When provided, the encryptor derives keystream values using this function
     * instead of the default `getPoseidonKeystreamGenerator()` singleton.
     * The resulting encryptor is cached per generator reference using a `WeakMap`.
     *
     * @defaultValue The return value of `getPoseidonKeystreamGenerator()`
     */
    readonly keystreamGenerator?: PoseidonKeystreamGeneratorFunction;
    /**
     * Custom modular addition function for encryption.
     *
     * @remarks
     * The modular addition computes `(plaintext + keystream) mod p` where `p` is
     * the BN254 field prime. The default implementation runs in constant time to
     * prevent timing side-channels.
     *
     * @defaultValue The constant-time `bn254ModuloAdd` function
     */
    readonly modAdd?: ModuloAddFunction;
}
/**
 * Optional dependencies for the Poseidon decryptor factory.
 *
 * @remarks
 * This interface enables dependency injection for the Poseidon decryptor. By
 * providing custom implementations of the keystream generator and modular subtraction
 * function, callers can test the decryptor in isolation or substitute alternative
 * field arithmetic implementations.
 *
 * The decryption formula is:
 * ```
 * plaintext[i] = modSub(ciphertext[i], keystream[i])
 * ```
 *
 * Where `keystream[i] = Poseidon([key, i, 2])`. The key must match the one used
 * during encryption to recover the original plaintext.
 *
 * @example
 * ```typescript
 * import { getPoseidonDecryptor, getPoseidonEncryptor } from '@umbra/sdk';
 *
 * // Round-trip test with custom modular arithmetic
 * const p = 21888242871839275222246405745257275088548364400416034343698204186575808495617n;
 * const customModSub = (a: bigint, b: bigint): bigint => ((a - b) % p + p) % p;
 *
 * const decryptor = getPoseidonDecryptor({ modSub: customModSub });
 * ```
 *
 * @see {@link getPoseidonDecryptor}
 * @see {@link PoseidonEncryptorDeps} for the symmetric encryption configuration
 * @public
 */
interface PoseidonDecryptorDeps {
    /**
     * Custom keystream generator function.
     *
     * @remarks
     * When provided, the decryptor derives keystream values using this function
     * instead of the default `getPoseidonKeystreamGenerator()` singleton.
     * The resulting decryptor is cached per generator reference using a `WeakMap`.
     *
     * @defaultValue The return value of `getPoseidonKeystreamGenerator()`
     */
    readonly keystreamGenerator?: PoseidonKeystreamGeneratorFunction;
    /**
     * Custom modular subtraction function for decryption.
     *
     * @remarks
     * The modular subtraction computes `(ciphertext - keystream) mod p` where `p` is
     * the BN254 field prime. The default implementation runs in constant time to
     * prevent timing side-channels.
     *
     * @defaultValue The constant-time `bn254ModuloSub` function
     */
    readonly modSub?: ModuloSubFunction;
}
/**
 * Returns a cached Poseidon encryptor function.
 *
 * This function returns a `PoseidonEncryptorFunction` that encrypts plaintexts using
 * a keystream-based approach. For each plaintext at position `i`, the ciphertext
 * is computed as:
 *
 * ```
 * ciphertext[i] = (plaintext[i] + keystream[i]) mod BN254_FIELD_PRIME
 * ```
 *
 * Where `keystream[i] = Poseidon([key, i, 2])`.
 *
 * @param opts - Optional configuration for the encryptor
 * @param opts.keystreamGenerator - Custom keystream generator (default: `getPoseidonKeystreamGenerator()`)
 * @param opts.modAdd - Custom modular addition function (default: `bn254ModuloAdd`)
 * @returns A `PoseidonEncryptorFunction` that encrypts plaintexts
 *
 * @remarks
 * ## Caching
 *
 * - When called without options, returns a cached singleton encryptor
 * - When called with custom options, caches the encryptor per option combination
 * - Uses WeakMap for caching to allow garbage collection
 *
 * ## Encryption Process
 *
 * 1. Validates all plaintexts are valid BN254 field elements
 * 2. Validates the key is a valid PoseidonKey
 * 3. Generates counters 0, 1, 2, ..., n-1 for n plaintexts
 * 4. Generates keystreams for each counter using the keystream generator
 * 5. Computes ciphertext[i] = modAdd(plaintext[i], keystream[i])
 * 6. Validates all outputs are valid PoseidonCiphertexts
 *
 * ## Security Notes
 *
 * - Uses constant-time modular addition by default to prevent timing attacks
 * - Each position gets a unique keystream derived from the key and counter
 * - The same (key, position) pair always produces the same keystream
 *
 * @example
 * ```typescript
 * import { getPoseidonEncryptor } from '@umbra/sdk';
 * import { assertPoseidonPlaintext, assertPoseidonKey } from '@umbra/sdk/types';
 *
 * // Get the encryptor (cached singleton)
 * const encryptor = getPoseidonEncryptor();
 *
 * // Prepare plaintexts
 * const plaintexts: PoseidonPlaintext[] = [100n, 200n, 300n];
 * plaintexts.forEach(assertPoseidonPlaintext);
 *
 * // Encrypt with a key
 * const key: PoseidonKey = transactionViewingKey;
 * assertPoseidonKey(key);
 *
 * const ciphertexts = await encryptor(plaintexts, key);
 * // ciphertexts[0] = (plaintexts[0] + keystream[0]) mod p
 * // ciphertexts[1] = (plaintexts[1] + keystream[1]) mod p
 * // ciphertexts[2] = (plaintexts[2] + keystream[2]) mod p
 * ```
 *
 * @example
 * ```typescript
 * // Using custom modular arithmetic
 * const customModAdd: ModuloAddFunction = (a, b) => (a + b) % BN254_FIELD_PRIME;
 *
 * const encryptor = getPoseidonEncryptor({
 *     modAdd: customModAdd
 * });
 *
 * const ciphertexts = await encryptor(plaintexts, key);
 * ```
 *
 * @public
 */
declare function getPoseidonEncryptor(deps?: PoseidonEncryptorDeps): PoseidonEncryptorFunction;
/**
 * Returns a cached Poseidon decryptor function.
 *
 * This function returns a `PoseidonDecryptorFunction` that decrypts ciphertexts using
 * a keystream-based approach. For each ciphertext at position `i`, the plaintext
 * is computed as:
 *
 * ```
 * plaintext[i] = (ciphertext[i] - keystream[i]) mod BN254_FIELD_PRIME
 * ```
 *
 * Where `keystream[i] = Poseidon([key, i, 2])`.
 *
 * @param opts - Optional configuration for the decryptor
 * @param opts.keystreamGenerator - Custom keystream generator (default: `getPoseidonKeystreamGenerator()`)
 * @param opts.modSub - Custom modular subtraction function (default: `bn254ModuloSub`)
 * @returns A `PoseidonDecryptorFunction` that decrypts ciphertexts
 *
 * @remarks
 * ## Caching
 *
 * - When called without options, returns a cached singleton decryptor
 * - When called with custom options, caches the decryptor per option combination
 * - Uses WeakMap for caching to allow garbage collection
 *
 * ## Decryption Process
 *
 * 1. Validates all ciphertexts are valid BN254 field elements
 * 2. Validates the key is a valid PoseidonKey
 * 3. Generates counters 0, 1, 2, ..., n-1 for n ciphertexts
 * 4. Generates keystreams for each counter using the keystream generator
 * 5. Computes plaintext[i] = modSub(ciphertext[i], keystream[i])
 * 6. Validates all outputs are valid PoseidonPlaintexts
 *
 * ## Security Notes
 *
 * - Uses constant-time modular subtraction by default to prevent timing attacks
 * - The key must be the same key used during encryption
 * - Using a wrong key will produce incorrect (garbage) plaintext output
 *
 * @example
 * ```typescript
 * import { getPoseidonDecryptor, getPoseidonEncryptor } from '@umbra/sdk';
 * import { assertPoseidonKey } from '@umbra/sdk/types';
 *
 * // Encrypt some data
 * const encryptor = getPoseidonEncryptor();
 * const plaintexts = [100n, 200n, 300n];
 * const key: PoseidonKey = transactionViewingKey;
 * const ciphertexts = await encryptor(plaintexts, key);
 *
 * // Decrypt the data
 * const decryptor = getPoseidonDecryptor();
 * const recovered = await decryptor(ciphertexts, key);
 * // recovered = [100n, 200n, 300n]
 * ```
 *
 * @example
 * ```typescript
 * // Using custom modular arithmetic
 * const customModSub: ModuloSubFunction = (a, b) => {
 *     const diff = a - b;
 *     return diff < 0n ? diff + BN254_FIELD_PRIME : diff;
 * };
 *
 * const decryptor = getPoseidonDecryptor({
 *     modSub: customModSub
 * });
 *
 * const plaintexts = await decryptor(ciphertexts, key);
 * ```
 *
 * @public
 */
declare function getPoseidonDecryptor(deps?: PoseidonDecryptorDeps): PoseidonDecryptorFunction;
/**
 * Maximum number of inputs the Poseidon aggregator can handle in a single call.
 *
 * @remarks
 * The aggregator uses a two-round approach:
 * - Round 1 splits inputs into chunks of up to {@link MAX_POSEIDON_INPUTS} (12) and hashes each chunk.
 * - Round 2 hashes all Round 1 outputs into a single final hash.
 *
 * Since Round 1 produces at most 12 outputs (each from a 12-element chunk),
 * Round 2 can handle them all in one call. This gives a theoretical maximum of
 * `12 * 12 = 144` inputs total.
 *
 * This limit directly constrains the ZK proof aggregated public input. The 70-element
 * aggregated Poseidon hash used as the single ZK proof public input for Umbra claim
 * operations (aggregating nullifiers, commitments, timestamps, addresses, etc.) fits
 * well within this bound.
 *
 * @example
 * ```typescript
 * import { getPoseidonAggregator, MAX_AGGREGATOR_INPUTS } from '@umbra/sdk';
 *
 * const aggregator = getPoseidonAggregator();
 *
 * // Maximum supported inputs
 * const maxInputs = Array.from({ length: MAX_AGGREGATOR_INPUTS }, (_, i) => BigInt(i));
 * maxInputs.forEach(assertBn254FieldElement);
 * const hash = await aggregator(maxInputs);
 * ```
 *
 * @see {@link getPoseidonAggregator} for the aggregator factory
 * @see {@link MAX_POSEIDON_INPUTS} for the base hash arity limit
 * @public
 */
declare const MAX_AGGREGATOR_INPUTS: number;
/**
 * Asynchronous function type for Poseidon hash aggregation over large input sets.
 *
 * @remarks
 * The aggregator chains two rounds of Poseidon hashing to process input sets
 * larger than the 12-element per-call limit. It always performs two rounds for
 * Circom circuit compatibility, even when the input set would fit in one call.
 *
 * Two-round construction:
 * ```
 * Round 1: hash chunks of up to 12 elements
 *   intermediates[i] = Poseidon(inputs[i*12 .. (i+1)*12])
 *
 * Round 2: hash all intermediates
 *   result = Poseidon(intermediates)
 * ```
 *
 * In Umbra, this is the function used to produce the single 70-element aggregated
 * Poseidon hash that serves as the sole ZK proof public input for claim operations.
 * The 70 elements aggregate nullifiers, commitments, timestamps, destination addresses,
 * amounts, and other ZK-circuit inputs across up to 10 UTXOs.
 *
 * @param inputs - Array of `Bn254FieldElement` values to hash (1 to {@link MAX_AGGREGATOR_INPUTS} elements)
 * @returns A `Promise` resolving to the aggregated `Bn254FieldElement` hash output
 *
 * @throws {Error} If `inputs` is empty
 * @throws {Error} If `inputs.length` exceeds {@link MAX_AGGREGATOR_INPUTS}
 *
 * @example
 * ```typescript
 * const aggregator: PoseidonAggregatorFunction = getPoseidonAggregator();
 *
 * // 70-element aggregated hash for ZK public input
 * const publicInputs: Bn254FieldElement[] = [...nullifiers, ...commitments, ...rest];
 * const aggregatedHash = await aggregator(publicInputs);
 * ```
 *
 * @see {@link getPoseidonAggregator} for the factory function
 * @see {@link MAX_AGGREGATOR_INPUTS} for the maximum supported input count
 * @public
 */
type PoseidonAggregatorFunction = (inputs: readonly Bn254FieldElement[]) => Promise<Bn254FieldElement>;
/**
 * Optional dependencies for the Poseidon aggregator factory.
 *
 * @remarks
 * This interface enables dependency injection for the Poseidon aggregator.
 * Providing a custom hasher allows substituting test doubles or verifying
 * the aggregator's two-round structure independently of the hash implementation.
 *
 * When no dependencies are provided, `getPoseidonAggregator()` uses the cached
 * default hasher from `getPoseidonHasher()`.
 *
 * @example
 * ```typescript
 * import { getPoseidonAggregator } from '@umbra/sdk';
 *
 * const calls: Bn254FieldElement[][] = [];
 * const trackingHasher: PoseidonHashFunction = async (inputs) => {
 *   calls.push([...inputs]);
 *   return getPoseidonHasher()(inputs);
 * };
 * const aggregator = getPoseidonAggregator({ hasher: trackingHasher });
 * // After calling aggregator([a, b, ..., z]), inspect `calls` to verify
 * // Round 1 chunks and the Round 2 combination.
 * ```
 *
 * @see {@link getPoseidonAggregator}
 * @public
 */
interface PoseidonAggregatorDeps {
    /**
     * Optional custom hasher function.
     *
     * @remarks
     * When provided, the aggregator uses this hasher for both rounds of hashing
     * instead of the default `getPoseidonHasher()` singleton. The resulting
     * aggregator is cached per hasher reference using a `WeakMap`.
     *
     * @defaultValue The return value of `getPoseidonHasher()`
     */
    readonly hasher?: PoseidonHashFunction;
}
/**
 * Returns a cached Poseidon aggregator function.
 *
 * The aggregator chains Poseidon hash calls to process large input sets
 * (up to 144 elements), matching the behavior of the Circom `PoseidonAggregator` circuit.
 *
 * @param deps - Optional dependencies including custom hasher function.
 * @returns A `PoseidonAggregatorFunction` that computes aggregated hashes
 *
 * @remarks
 * ## Caching
 *
 * - When called without arguments (using default hasher), returns a cached singleton
 * - When called with a custom hasher, returns a cached function per hasher instance
 * - The cache uses WeakMap for custom hashers to allow garbage collection
 *
 * ## Two-Round Aggregation
 *
 * The aggregation works as follows:
 * 1. **Round 1**: Split inputs into chunks of up to 12 elements each
 *    and hash each chunk with Poseidon
 * 2. **Round 2**: Hash all the outputs from Round 1 together
 *
 * ## Circuit Compatibility
 *
 * Unlike a naive implementation that might skip Round 2 for small inputs,
 * this function ALWAYS performs both rounds. For example, with 5 inputs:
 *
 * ```
 * Naive:   Poseidon([a, b, c, d, e])
 * Correct: Poseidon([Poseidon([a, b, c, d, e])])
 * ```
 *
 * This matches the Circom circuit which always computes
 * `Poseidon(numFirstRoundHashes)(firstRoundOutputs)`.
 *
 * ## Input Constraints
 *
 * - Minimum: 1 input
 * - Maximum: 144 inputs (12 * 12)
 *
 * @example
 * ```typescript
 * import { getPoseidonAggregator } from '@umbra-privacy/sdk';
 * import { assertBn254FieldElement } from '@umbra-privacy/sdk/types';
 *
 * // Get the aggregator (cached singleton)
 * const aggregator = getPoseidonAggregator();
 *
 * // Hash 5 field elements
 * const inputs = [1n, 2n, 3n, 4n, 5n].map(x => {
 *   assertBn254FieldElement(x);
 *   return x;
 * });
 * const hash = await aggregator(inputs);
 *
 * // Hash 100 field elements (across multiple chunks)
 * const largeInputs = Array.from({ length: 100 }, (_, i) => {
 *   const val = BigInt(i);
 *   assertBn254FieldElement(val);
 *   return val;
 * });
 * const largeHash = await aggregator(largeInputs);
 * ```
 *
 * @example
 * ```typescript
 * // Using a custom hasher
 * const customHasher: PoseidonHashFunction = myCustomHasher;
 * const aggregator = getPoseidonAggregator({ hasher: customHasher });
 *
 * const hash = await aggregator(inputs);
 * ```
 *
 * @public
 */
declare function getPoseidonAggregator(deps?: PoseidonAggregatorDeps): PoseidonAggregatorFunction;


 * @example
 * ```typescript
 * // Encoding a token balance as a plaintext:
 * const balance: bigint = 1_000_000n; // e.g. 1 USDC in lamports
 * assertRcPlaintext(balance, "balance");
 * const { ciphertexts, nonce } = await encryptor([balance]);

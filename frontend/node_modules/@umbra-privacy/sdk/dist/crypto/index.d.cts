/**
 * Commitment Generation
 *
 * This module implements cryptographic commitment generation functions used
 * in the Umbra privacy protocol.
 *
 * ## User Commitment
 *
 * The user commitment is computed as a depth-2 Merkle tree root using Poseidon
 * hashing over the BN254 scalar field:
 *
 * ```
 * left  = Poseidon(masterViewingKey, mvkBlindingFactor)
 * right = Poseidon(poseidonPrivateKey, poseidonPrivateKeyBlindingFactor)
 * root  = Poseidon(left, right)
 * ```
 *
 * This commitment is stored on-chain inside the `EncryptedUserAccount`
 * and can be opened inside a Groth16 ZK circuit to prove key ownership without
 * revealing the underlying keys.
 *
 * ## Caching Strategy
 *
 * Generator functions are expensive to create because they close over a Poseidon
 * hasher that may require WASM initialisation. To avoid paying that cost on every
 * call, this module maintains two caches:
 *
 * - A module-level singleton for the default (no-deps) case.
 * - A `WeakMap` keyed on the custom hasher instance for the injected-deps case,
 *   which allows garbage collection when the hasher is no longer referenced.
 *
 * @packageDocumentation
 * @module implementation/cryptography/commitment
 */

/**
 * Returns a cached {@link UserCommitmentGeneratorFunction} for computing user
 * commitment Merkle roots.
 *
 * This is the primary entry point for commitment generation. The returned
 * function computes a depth-2 Poseidon Merkle tree root over BN254:
 *
 * ```
 * left  = Poseidon(masterViewingKey, mvkBlindingFactor)
 * right = Poseidon(poseidonPrivateKey, poseidonPrivateKeyBlindingFactor)
 * root  = Poseidon(left, right)
 * ```
 *
 * @param deps - Optional dependency injection bag. Pass `{ hasher }` to
 *   substitute the default WASM-backed Poseidon hasher with a custom
 *   implementation. If omitted or `undefined`, the factory uses and caches
 *   the singleton returned by `getPoseidonHasher()`.
 * @returns A {@link UserCommitmentGeneratorFunction} that, when called with the
 *   four key/blinding-factor inputs, asynchronously produces the BN254 field
 *   element representing the commitment root.
 *
 * @remarks
 * ## Caching
 *
 * - When called without `deps` (or with `deps.hasher === undefined`), the
 *   factory creates and stores a module-level singleton on first call and
 *   returns that same instance on every subsequent call. This is safe because
 *   the default hasher is itself a singleton.
 * - When called with a custom `hasher`, the factory looks up the generator in a
 *   `WeakMap` keyed on the hasher reference. If no entry exists, it creates one
 *   and stores it. This ensures that a single custom hasher instance always
 *   maps to the same generator function, while allowing garbage collection when
 *   the hasher falls out of scope.
 *
 * ## On-Chain Usage
 *
 * The user commitment produced by the returned function is stored in the
 * `EncryptedUserAccount` on Solana. It serves three roles:
 *
 * - Binds the user's identity to their account without exposing key material
 * - Acts as a public input to Groth16 circuits that verify key ownership before
 *   allowing fund claims
 * - Prevents impersonation: an adversary cannot open the commitment to a
 *   different key pair under the Poseidon collision-resistance assumption
 *
 * ## Security Properties
 *
 * - Hiding: the root reveals nothing about the four input field elements
 * - Binding: collision resistance of Poseidon makes it infeasible to find two
 *   distinct input tuples that produce the same root
 * - ZK-friendliness: Poseidon's low multiplicative depth keeps circuit
 *   constraint counts small, reducing proof generation time
 *
 * @example
 * ```typescript
 * import { getUserCommitmentGeneratorFunction } from "@umbra-privacy/sdk";
 *
 * // Default usage — recommended for production
 * const generateCommitment = getUserCommitmentGeneratorFunction();
 *
 * const commitment = await generateCommitment(
 *   masterViewingKey,
 *   mvkBlindingFactor,
 *   poseidonPrivateKey,
 *   poseidonPrivateKeyBlindingFactor,
 * );
 *
 * // Store `commitment` on-chain in the EncryptedUserAccount
 * ```
 *
 * @example
 * ```typescript
 * import { getUserCommitmentGeneratorFunction } from "@umbra-privacy/sdk";
 *
 * // Inject a custom hasher for testing with deterministic outputs
 * const generateCommitment = getUserCommitmentGeneratorFunction({
 *   hasher: mockPoseidonHasher,
 * });
 *
 * const commitment = await generateCommitment(
 *   mvk,
 *   mvkBlinding,
 *   poseidonKey,
 *   poseidonKeyBlinding,
 * );
 * ```
 *
 * @see {@link UserCommitmentGeneratorFunction} for the function type contract
 * @see {@link UserCommitmentGeneratorDeps} for the dependency injection interface
 * @see {@link createUserCommitmentGeneratorFunction} for the internal factory
 * @public
 */
declare function getUserCommitmentGeneratorFunction(deps?: UserCommitmentGeneratorDeps): UserCommitmentGeneratorFunction;


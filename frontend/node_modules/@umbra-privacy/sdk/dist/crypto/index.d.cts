 * // Or use a counter-based nonce (must be managed externally):
 * let counter = 0n;
 * const counterNonce = counter as RcEncryptionNonce;
 * assertRcEncryptionNonce(counterNonce, "counterNonce");
 * counter++;
 * ```
 *
 * @see {@link assertRcEncryptionNonce} — runtime assertion and type narrowing
 * @see {@link Nonce} — alias for this type
 */
